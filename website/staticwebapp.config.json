{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/downloads/*", "/assets/*", "/styles/*", "/scripts/*", "/api/*"]
  },
  "platform": { "apiRuntime": "node:20" },
  "mimeTypes": { ".zip": "application/zip", ".mp4": "video/mp4" },
  "routes": [
    { "route": "/styles/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/scripts/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
