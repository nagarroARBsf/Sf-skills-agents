#!/usr/bin/env node
'use strict';
// sf-sdlc — one command-line tool behind the SDLC agents, the hooks, people and CI.
// Node.js standard library only. Every command accepts --json.

const fs = require('fs');
const path = require('path');
const crypto = require('crypto');
const lib = require('../hooks/lib');
const envfile = require('../hooks/envfile');
const ops = require('../hooks/ops');
const checks = require('../hooks/checks');
const mcp = require('../hooks/mcp');
const diagramLib = require('../hooks/diagram');
const browserLib = require('../hooks/browser');
const discoverLib = require('../hooks/discover');

const argv = process.argv.slice(2);
const JSON_OUT = argv.includes('--json');
const flags = {};
const pos = [];
const VALUE_FLAGS = new Set(['--jira', '--org', '--from', '--severity', '--job-id', '--run-id', '--tests', '--level', '--manifest', '--source-dir', '--wait', '--profile', '--tail', '--output', '--rule-selector', '--report', '--type', '--story', '--layer', '--title', '--format', '--alias', '--instance-url']);
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  if (a.startsWith('--')) {
    const [k, v] = a.split('=');
    if (v !== undefined) flags[k] = v;
    else if (VALUE_FLAGS.has(k) && argv[i + 1] !== undefined && !argv[i + 1].startsWith('--')) flags[k] = argv[++i];
    else flags[k] = true;
  } else pos.push(a);
}

const root = lib.projectDir();
let cfg = lib.loadConfig(root);

function out(data, text) {
  if (JSON_OUT) process.stdout.write(JSON.stringify(data, null, 2) + '\n');
  else process.stdout.write((typeof text === 'function' ? text() : text || JSON.stringify(data, null, 2)) + '\n');
}
function fail(msg, code = 1) {
  if (JSON_OUT) process.stdout.write(JSON.stringify({ ok: false, error: msg }, null, 2) + '\n');
  else process.stderr.write(`sf-sdlc: ${msg}\n`);
  process.exit(code);
}

// ------------------------------------------------------------------ doctor

function doctorRows() {
  const rows = [];
  const add = (name, ok, detail, fix, required = true) => rows.push({ name, ok, required, detail, fix: ok ? undefined : fix });
  const major = Number(process.versions.node.split('.')[0]);
  add('node', major >= 18, `v${process.versions.node}`, 'Install Node.js 18 or later.');
  add('git', lib.has('git'), '', 'Install git.');
  const sf = lib.has('sf');
  add('sf CLI', sf, sf ? (lib.run('sf', ['--version'], { timeout: 60000 }).stdout.split('\n')[0] || '').trim() : '', 'npm install --global @salesforce/cli');
  let plugins = '';
  if (sf) plugins = lib.run('sf', ['plugins'], { timeout: 60000 }).stdout;
  const plug = (re) => { const m = re.exec(plugins); return m ? m[0].trim() : null; };
  const ca = plug(/^code-analyzer\s+\S+/m);
  add('Salesforce Code Analyzer (sf code-analyzer)', Boolean(ca), ca || '', 'sf plugins install code-analyzer');
  const java = lib.run('java', ['-version'], { timeout: 20000 });
  const jv = /version "(\d+)/.exec(java.stderr + java.stdout);
  add('Java 11+ (Code Analyzer PMD/CPD engines)', Boolean(jv) && Number(jv[1]) >= 11, jv ? `Java ${jv[1]}` : 'not found', 'Install a JDK 11 or later (17+ recommended) and put it on PATH.');
  const sgd = plug(/^sfdx-git-delta\s+\S+/m);
  add('sfdx-git-delta (delta manifests)', Boolean(sgd), sgd || 'not installed — sf-sdlc delta uses its built-in git mapping', 'sf plugins install sfdx-git-delta', false);
  const lfs = plug(/^lightning-flow-scanner\s+\S+/m);
  add('Lightning Flow Scanner', Boolean(lfs), lfs || 'not installed', 'sf plugins install lightning-flow-scanner', false);
  const gh = lib.has('gh');
  add('gh CLI (pull requests, releases)', gh, '', 'Install GitHub CLI (https://cli.github.com) and run `gh auth login`.', false);
  if (gh) add('gh signed in', lib.run('gh', ['auth', 'status'], { timeout: 30000 }).status === 0, '', 'Run `gh auth login` (browser), or put GITHUB_TOKEN in .env and run `sf-sdlc env gh-login`.', false);
  const est = envfile.status(root);
  const groups = Object.entries(est.groups).map(([n, g]) => `${n}: ${g.state}`).join(', ');
  add('.env credentials (Salesforce login address, Jira, Confluence, GitHub tokens)', est.exists && est.gitignored, est.exists ? `${est.gitignored ? 'git-ignored' : 'NOT git-ignored'}; ${groups}` : 'no .env (only needed for token-based Jira/Confluence or GitHub)', est.exists ? 'Run `sf-sdlc init` to git-ignore .env.' : 'Run `sf-sdlc env init`, then fill the values in your editor.', false);
  const tokenJira = ['jira', 'confluence'].some((g) => est.groups[g].state === 'configured');
  if (tokenJira) add('uv or Docker (runs the token-based Jira/Confluence MCP server)', lib.has('uvx') || lib.has('docker'), lib.has('uvx') ? 'uvx' : lib.has('docker') ? 'docker' : 'neither found', 'Install uv: https://docs.astral.sh/uv/getting-started/installation/ (or Docker), then restart Claude Code.', false);
  if (lib.IS_PLUGIN) {
    const ps = lib.readJson(path.join(root, '.claude', 'settings.json')) || {};
    const on = Object.entries(ps.enabledPlugins || {}).some(([k, v]) => k.startsWith('sf-sdlc@') && v === true);
    add('sf-sdlc plugin enabled for this project (project scope)', on, on ? 'teammates get it from .claude/settings.json' : 'enabled for you only', 'Run `sf-sdlc init` (writes enabledPlugins to .claude/settings.json), then commit it.', false);
    const rulesDir = path.join(root, '.claude', 'rules');
    add('kit rules in .claude/rules/', fs.existsSync(path.join(rulesDir, lib.KIT_RULE_FILE)), '', 'Run `sf-sdlc init` to install the kit rules as project files.', false);
  }
  const stale = lib.obsoleteKitFiles(root);
  add('no files left over from an older kit version', stale.length === 0, stale.length ? stale.join(', ') : '', `Delete these (kit 3.0 replaced them with skills and new output styles): ${stale.join(' ')}`, false);
  add('mermaid-cli (SVG diagrams for Jira/Confluence)', lib.has('mmdc'), '', 'npm install --global @mermaid-js/mermaid-cli', false);
  const py = ['python3', 'python'].find((c) => { if (!lib.has(c)) return false; const v = lib.run(c, ['--version'], { timeout: 10000 }); return /Python 3/.test(v.stdout + v.stderr); });
  add('Python 3 (draw.io skill scripts)', Boolean(py), py || 'not found', 'Install Python 3: https://www.python.org/downloads/', false);
  const dio = diagramLib.findDrawio();
  add('draw.io desktop (PNG/SVG/PDF of Salesforce-style diagrams)', Boolean(dio), dio ? dio.cmd : 'not found — .drawio files still open in draw.io web or the VS Code Draw.io extension', 'Install draw.io desktop (free): https://www.drawio.com', false);
  const proj = lib.sfdxProject(root);
  add('sfdx-project.json', Boolean(proj), proj ? `packages: ${lib.packageDirs(root, cfg).join(', ')}; API ${lib.apiVersion(root, cfg) || 'unset'}` : 'not a Salesforce DX project', 'Create the project with `sf project generate`, or run from the project root.', false);
  const v = lib.validateConfig(cfg);
  add('.claude/sf-sdlc.json', cfg._exists && v.ok, v.errors.concat(v.warnings).join('; ') || 'valid', 'Run `sf-sdlc init`, then edit .claude/sf-sdlc.json.');
  const target = lib.defaultOrg(root);
  if (sf) {
    const org = lib.classifyOrg(target, cfg, root);
    add('default target org', Boolean(target), target ? `${target} (${org.kind})` : 'none', 'sf config set target-org <alias>', false);
  }
  const servers = mcp.enabledServers(cfg);
  if (servers.length) {
    const health = mcp.readHealth(root);
    const seen = servers.map((n) => `${n}: ${health[n] ? `${health[n].state} (${health[n].org || '?'}, ${String(health[n].checkedAt || '').slice(0, 10)})` : 'not checked'}`);
    const allOk = servers.every((n) => health[n] && health[n].state === 'ok');
    add('Salesforce hosted MCP servers (last observed)', allOk, seen.join('; '), 'Run `sf-sdlc mcp status`. Turn the servers on in Setup → MCP Servers (API Catalog) and log in with `sf org login web --alias <alias>`.', false);
  }
  const gi = fs.existsSync(path.join(root, '.gitignore')) ? fs.readFileSync(path.join(root, '.gitignore'), 'utf8') : '';
  add('.gitignore covers .sf/, .sfdx/, .sf-sdlc/', ['.sf/', '.sfdx/', '.sf-sdlc/'].every((p) => gi.includes(p)), '', 'Run `sf-sdlc init` to add the entries.');
  const sk = skillsState();
  add('skill listing budget', sk.onDemandChars <= 8000, `${sk.installed.length} project skills (${sk.installed.filter((x) => x.core).length} in the mandatory core set), about ${sk.listingChars} description characters, ${sk.onDemandChars} of them from on-demand skills. Claude Code shares roughly 1% of the context window between all skill descriptions (about 8,000 characters on a 200k-token model) and shortens or drops descriptions beyond that, so the large core set means some skills are found by name rather than by description`, 'Remove on-demand skills the project does not need: `sf-sdlc skills remove <name>`.', false);
  const bs = browserLib.status(root, cfg);
  add('browser for UI tests (Playwright MCP)', !bs.enabled || bs.ready, !bs.enabled ? 'turned off (browser.enabled is false)' : bs.ready ? `${bs.browser}${bs.headless ? ', headless' : ''}; sign-in kept in ${bs.profile}/${bs.profileExists ? '' : ' (created on first use)'}${bs.inUse ? ' — in use by another browser now' : ''}${bs.note ? `; ${bs.note}` : ''}` : bs.reason, 'Install Node.js 18+ (it brings npx), then restart Claude Code.', false);
  const IDS = [[/^node$/, 'node'], [/^git$/, 'git'], [/^sf CLI/, 'sf'], [/Code Analyzer \(/, 'code-analyzer'], [/^Java/, 'java'], [/^sfdx-git-delta/, 'sgd'], [/^Lightning Flow Scanner/, 'lfs'], [/^gh CLI/, 'gh'], [/^gh signed in/, 'gh-auth'], [/^\.env/, 'env'], [/^uv or Docker/, 'uv'], [/plugin enabled/, 'plugin-scope'], [/^kit rules/, 'rules'], [/^mermaid-cli/, 'mermaid'], [/^draw\.io desktop/, 'drawio'], [/^Python 3/, 'python'], [/^sfdx-project/, 'sfdx'], [/sf-sdlc\.json$/, 'config'], [/^default target org/, 'org'], [/hosted MCP/, 'mcp'], [/^\.gitignore/, 'gitignore'], [/^skill listing/, 'budget'], [/^browser for UI/, 'browser']];
  for (const r of rows) r.id = (IDS.find(([re]) => re.test(r.name)) || [])[1] || r.name;
  return rows;
}

function doctor() {
  const rows = doctorRows();
  const ok = rows.every((r) => r.ok || !r.required);
  out({ ok, checks: rows }, () => rows.map((r) => `${r.ok ? '✔' : r.required ? '✘' : '•'} ${r.name}${r.detail ? ' — ' + r.detail : ''}${r.fix ? `\n    fix: ${r.fix}` : ''}`).join('\n') + `\n\n${ok ? 'Ready.' : 'Required items are missing.'}`);
  process.exit(ok ? 0 : 1);
}

// ------------------------------------------------------------------ init

function initRun() {
  const done = [];
  const skipped = [];
  const cp = lib.configPaths(root);
  fs.mkdirSync(path.dirname(cp.shared), { recursive: true });
  if (!fs.existsSync(cp.shared)) {
    const c = JSON.parse(JSON.stringify(lib.DEFAULTS));
    const proj = lib.sfdxProject(root);
    c.project.name = (proj && proj.name) || path.basename(root);
    if (proj && proj.namespace) c.salesforce.namespacePrefix = proj.namespace;
    const head = lib.git(['symbolic-ref', '--short', 'refs/remotes/origin/HEAD'], root);
    if (head) c.git.mainBranch = head.replace(/^origin\//, '');
    const branches = (lib.git(['branch', '-a', '--format=%(refname:short)'], root) || '').split('\n');
    if (!branches.some((b) => /(^|\/)develop$/.test(b))) { c.git.integrationBranch = c.git.mainBranch; c.git.pullRequestBase = c.git.mainBranch; }
    const target = lib.defaultOrg(root);
    if (target && lib.classifyOrg(target, c, root).kind !== 'production') c.orgs.dev = target;
    fs.writeFileSync(cp.shared, JSON.stringify({ $comment: 'sf-sdlc project configuration. Reference: SETUP.md. Personal overrides go in sf-sdlc.local.json (not committed).', ...c }, null, 2) + '\n');
    done.push('.claude/sf-sdlc.json');
  } else skipped.push('.claude/sf-sdlc.json (exists)');

  const gi = path.join(root, '.gitignore');
  const cur = fs.existsSync(gi) ? fs.readFileSync(gi, 'utf8') : '';
  const want = ['.sf/', '.sfdx/', '.sf-sdlc/', '.env', '.claude/sf-sdlc.local.json', '.claude/settings.local.json'].filter((l) => !cur.split('\n').map((s) => s.trim()).includes(l));
  if (want.length) { fs.writeFileSync(gi, cur + (cur && !cur.endsWith('\n') ? '\n' : '') + '# sf-sdlc: CLI auth, local state and personal overrides\n' + want.join('\n') + '\n'); done.push('.gitignore (+' + want.join(', ') + ')'); }

  const tpl = path.join(lib.KIT_ROOT, 'templates');
  const copyIfMissing = (from, to) => {
    const src = path.join(tpl, from);
    const dest = path.join(root, to);
    if (!fs.existsSync(src)) return;
    if (fs.existsSync(dest)) { skipped.push(`${to} (exists)`); return; }
    fs.mkdirSync(path.dirname(dest), { recursive: true });
    fs.copyFileSync(src, dest); done.push(to);
  };
  if (lib.sfdxProject(root)) {
    copyIfMissing('code-analyzer.yml', 'code-analyzer.yml');
    copyIfMissing('code-analyzer-ci.yml', '.github/workflows/sf-code-analyzer.yml');
  }
  if (!lib.IS_PLUGIN) mergeMcpServers(done, skipped);
  copyIfMissing('pull_request_template.md', '.github/pull_request_template.md');
  if (lib.IS_PLUGIN) {
    mergeProjectSettings(done, skipped);
    const files = syncProjectFiles();
    for (const f of files) {
      if (f.result === 'created') done.push(f.path);
      else (f.result === 'updated' ? done : skipped).push(`${f.path} (${f.result})`);
    }
  }
  const sample = envfile.ensureSample(root);
  if (sample.result === 'created' || sample.result === 'updated') done.push(`.env.sample (${sample.result}: the settings list with no values; commit it)`);
  else skipped.push(`.env.sample (${sample.result})`);
  const env = envfile.ensure(root);
  if (env.result === 'kept') skipped.push('.env (exists; values untouched)');
  else done.push(`.env (${env.result}${env.added ? ': ' + env.added.join(', ') : ''}; fill the values in your editor)`);
  return { created: done, skipped };
}

function init() {
  const { created: done, skipped } = initRun();
  out({ ok: true, created: done, skipped, next: 'Fill .env in your editor (Salesforce login address and user name; Jira/Confluence/GitHub tokens if you use them; .env.sample lists every key), edit .claude/sf-sdlc.json (org aliases, production aliases, Jira key), then run `sf-sdlc doctor` and `sf-sdlc skills recommend`. Restart Claude Code so new settings, rules and MCP servers load. `sf-sdlc setup` does all of this in one go.' },
    () => `${done.map((d) => 'created  ' + d).concat(skipped.map((s) => 'kept     ' + s)).join('\n')}\n\nNext: fill .env in your editor (Salesforce login address and user name; Jira/Confluence/GitHub tokens if you use them; .env.sample lists every key), edit .claude/sf-sdlc.json (org aliases, production aliases, Jira key), then run \`sf-sdlc doctor\` and \`sf-sdlc skills recommend\`. Restart Claude Code so new settings, rules and MCP servers load.`);
}

// Plugin users: the project's shared .claude/settings.json gets the kit's permissions and turns the
// plugin on at project scope (the documented way to give a whole team a plugin). Lists are merged,
// existing keys are never changed.
function mergeProjectSettings(done, skipped) {
  const tpl = lib.readJson(path.join(lib.KIT_ROOT, 'templates', 'project-settings.json'));
  if (!tpl) return;
  const file = path.join(root, '.claude', 'settings.json');
  const exists = fs.existsSync(file);
  const cur = exists ? lib.readJson(file) : {};
  if (!cur) { skipped.push('.claude/settings.json (not valid JSON; merge templates/project-settings.json by hand)'); return; }
  const before = JSON.stringify(cur);
  cur.env = { ...(tpl.env || {}), ...(cur.env || {}) };
  cur.permissions = cur.permissions || {};
  for (const k of ['allow', 'ask', 'deny']) {
    const list = cur.permissions[k] || [];
    for (const r of (tpl.permissions && tpl.permissions[k]) || []) if (!list.includes(r)) list.push(r);
    if (list.length) cur.permissions[k] = list;
  }
  for (const k of Object.keys(tpl)) if (!['env', 'permissions'].includes(k) && cur[k] === undefined) cur[k] = tpl[k];
  const manifest = lib.readJson(path.join(lib.KIT_ROOT, '.claude-plugin', 'plugin.json')) || {};
  const market = manifest.metadata && manifest.metadata.marketplace;
  if (market && market.name) {
    const id = `${manifest.name}@${market.name}`;
    cur.enabledPlugins = cur.enabledPlugins || {};
    if (cur.enabledPlugins[id] === undefined) cur.enabledPlugins[id] = true;
    if (market.source) {
      cur.extraKnownMarketplaces = cur.extraKnownMarketplaces || {};
      if (!cur.extraKnownMarketplaces[market.name]) cur.extraKnownMarketplaces[market.name] = { source: market.source };
    }
  }
  if (JSON.stringify(cur) === before) { skipped.push('.claude/settings.json (already up to date)'); return; }
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, JSON.stringify(cur, null, 2) + '\n');
  done.push(`.claude/settings.json (${exists ? 'merged' : 'created'}: kit permissions, .env read-deny, plugin enabled at project scope)`);
}

// Plugin users: the kit's rules become project files in .claude/rules/ — Claude Code loads them by
// path (plugins cannot ship rules or CLAUDE.md). Tracked in the lock file by content hash, so a later
// init updates untouched files and never overwrites a file the team edited or wrote itself.
function syncProjectFiles() {
  const src = path.join(lib.KIT_ROOT, 'templates', 'project');
  const res = [];
  if (!fs.existsSync(src)) return res;
  const lock = readLock();
  lock.files = lock.files || {};
  const sha = (t) => crypto.createHash('sha256').update(t).digest('hex');
  const walkFiles = (d, rel = '') => fs.readdirSync(d, { withFileTypes: true }).flatMap((e) => e.isDirectory() ? walkFiles(path.join(d, e.name), path.join(rel, e.name)) : [path.join(rel, e.name)]);
  for (const rel of walkFiles(src)) {
    const key = rel.split(path.sep).join('/');
    const dest = path.join(root, '.claude', rel);
    const shown = `.claude/${key}`;
    const kit = fs.readFileSync(path.join(src, rel), 'utf8');
    if (!fs.existsSync(dest)) {
      fs.mkdirSync(path.dirname(dest), { recursive: true });
      fs.writeFileSync(dest, kit);
      lock.files[key] = sha(kit);
      res.push({ path: shown, result: 'created' });
      continue;
    }
    const cur = fs.readFileSync(dest, 'utf8');
    if (!lock.files[key]) { res.push({ path: shown, result: cur === kit ? 'exists, identical' : 'exists, not managed by sf-sdlc' }); continue; }
    if (sha(cur) !== lock.files[key]) { res.push({ path: shown, result: 'locally modified; not overwritten' }); continue; }
    if (cur === kit) { res.push({ path: shown, result: 'up to date' }); continue; }
    fs.writeFileSync(dest, kit);
    lock.files[key] = sha(kit);
    res.push({ path: shown, result: 'updated' });
  }
  writeLock(lock);
  return res;
}

// ------------------------------------------------------------------ env

function envCmd() {
  const sub = pos[1] || 'status';
  if (sub === 'init') {
    const r = envfile.ensure(root);
    return out(r, `.env ${r.result}${r.added ? ': ' + r.added.join(', ') : ''}. Fill the values in your editor, never in the chat.`);
  }
  if (sub === 'status') {
    const st = envfile.status(root);
    return out(st, () => `.env: ${st.exists ? 'present' : 'missing (run `sf-sdlc env init`)'}${st.exists && !st.gitignored ? ' — NOT git-ignored: run `sf-sdlc init`' : ''}\n` +
      Object.values(st.groups).map((g) => `${g.state === 'configured' ? '✔' : g.state === 'partial' ? '!' : '•'} ${g.label}: ${g.state === 'default' ? 'defaults in use' : g.state}` +
        (g.state === 'partial' ? ` (missing: ${Object.entries(g.keys).filter(([, v]) => !v).map(([k]) => k).join(', ')})` : '')).join('\n') +
      '\n\nValues are never shown. Restart Claude Code after changing .env so MCP servers pick it up.');
  }
  if (sub === 'gh-login') {
    if (!lib.has('gh')) fail('the gh CLI is not installed. Install it from https://cli.github.com, then run this again (or run `gh auth login`).');
    const token = (envfile.read(root) || {}).GITHUB_TOKEN;
    if (!token) fail('GITHUB_TOKEN is empty in .env. Fill it in your editor, or run `gh auth login` to sign in through the browser.');
    const r = lib.run('gh', ['auth', 'login', '--with-token'], { cwd: root, input: token + '\n', timeout: 60000 });
    if (r.status !== 0) fail(`gh auth login failed: ${(r.stderr || '').replace(new RegExp(token.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'g'), '***').trim().slice(0, 300)}`);
    const s = lib.run('gh', ['auth', 'status'], { cwd: root, timeout: 30000 });
    return out({ ok: true }, `gh is signed in.${s.status === 0 ? '' : ' (gh auth status did not confirm; run it yourself to check.)'} You may now delete GITHUB_TOKEN from .env; gh keeps its own login.`);
  }
  if (sub === 'set') {
    const pairs = pos.slice(2).map((a) => { const i = a.indexOf('='); return i > 0 ? [a.slice(0, i), a.slice(i + 1)] : null; });
    if (!pairs.length || pairs.some((x) => !x)) fail(`usage: sf-sdlc env set KEY=VALUE [...]  (addresses and user names only: ${envfile.PLAIN_KEYS.join(', ')})`);
    const res = [];
    const bad = pairs.find(([k]) => !envfile.PLAIN_KEYS.includes(k));
    if (bad) fail(`"${bad[0]}" cannot be set from the command line: only ${envfile.PLAIN_KEYS.join(', ')}. Type secrets (tokens, passwords) into .env in your editor. Nothing was changed.`);
    try { for (const [k, v] of pairs) res.push(envfile.setPlain(root, k, v)); } catch (e) { fail(e.message); }
    return out({ ok: true, set: res.map((r) => r.key) }, `.env: set ${res.map((r) => r.key).join(', ')}. Tokens are still yours to type into .env in your editor.`);
  }
  fail('usage: sf-sdlc env status|init|set|gh-login');
}

// ------------------------------------------------------------------ browser

// Browser for UI tests (Playwright MCP, server "sf-browser"). Never prints a session or a password:
// `url` returns the org's instance address from the sf CLI org list, without a token.
function browserCmd() {
  const sub = pos[1] || 'status';
  if (sub === 'status') {
    const st = browserLib.status(root, cfg);
    return out(st, () => [
      `Browser for UI tests: ${!st.enabled ? 'off (browser.enabled is false)' : st.ready ? 'ready' : 'not ready — ' + st.reason}`,
      `  browser  ${st.browser}${st.headless ? ' (headless)' : ' (a window you can see)'}${st.note ? ' — ' + st.note : ''}`,
      `  server   ${st.package} (MCP server "sf-browser")`,
      `  sign-in  kept in ${st.profile}/ ${st.profileExists ? '(exists)' : '(created on first use)'}${st.keepsSignIn ? ', also across restarts' : st.profileExists ? ', NOT across restarts yet (fixed on the next browser start)' : ''}${st.inUse ? ` — in use now${st.pid ? ` by process ${st.pid}` : ''}; another Claude session must wait until that browser closes` : ''}`,
      '',
      'First use: Claude opens the browser at your org; you sign in yourself in that window, once. Later sessions stay signed in.',
      'Sign out everywhere: sf-sdlc browser reset',
    ].join('\n'));
  }
  if (sub === 'url') {
    const alias = lib.resolveOrg(flags['--org'] && flags['--org'] !== true ? String(flags['--org']) : (cfg.orgs.qa || cfg.orgs.dev || lib.defaultOrg(root)), cfg);
    if (!alias) fail('no org: pass --org <role|alias> (qa, uat, dev or an alias).');
    const c = lib.classifyOrg(alias, cfg, root);
    if (!['sandbox', 'scratch', 'developer'].includes(c.kind)) fail(`org "${alias}" is ${c.kind}${c.kind === 'unknown' ? ` (${c.reason}; treated as production)` : ''}. UI tests run only in sandbox, scratch or developer orgs.`);
    const o = (lib.orgList(root) || []).find((x) => String(x.alias || '').split(',').map((v) => v.trim()).includes(alias) || x.username === alias);
    if (!o || !o.instanceUrl) fail(`no instance URL for "${alias}" in the sf CLI org list. Sign in with \`sf-sdlc org login --alias ${alias}\`.`);
    const base = o.instanceUrl.replace(/\/$/, '');
    return out({ org: alias, kind: c.kind, instanceUrl: base, lightning: `${base}/lightning/page/home` }, `${alias} (${c.kind}): ${base}/lightning/page/home\nOpen it with the sf-browser tools; if the login page shows, the person signs in in that window.`);
  }
  if (sub === 'reset') {
    try { const r = browserLib.reset(root); return out(r, r.result === 'removed' ? `Removed ${browserLib.PROFILE_DIR}: the browser is signed out of every site. The next use asks the person to sign in again.` : 'Nothing to reset: no browser profile yet.'); } catch (e) { fail(e.message); }
  }
  fail('usage: sf-sdlc browser status|url [--org <role|alias>]|reset');
}

// `sf-sdlc org login`: sf org login web with the login address and alias from .env (SF_LOGIN_URL,
// SF_ORG_ALIAS) or the flags. Opens a browser; the person signs in there. The values are not printed.
function orgLogin() {
  const vals = envfile.read(root) || {};
  const alias = String(flags['--alias'] && flags['--alias'] !== true ? flags['--alias'] : vals.SF_ORG_ALIAS || 'dev').trim();
  const url = String(flags['--instance-url'] && flags['--instance-url'] !== true ? flags['--instance-url'] : vals.SF_LOGIN_URL || '').trim();
  if (!/^[A-Za-z0-9_.-]+$/.test(alias)) fail('the alias may contain letters, digits, dot, dash and underscore only.');
  if (url) { let u = null; try { u = new URL(url); } catch { /* below */ } if (!u || u.protocol !== 'https:' || !/(^|\.)(salesforce|force)\.com$/i.test(u.hostname)) fail('SF_LOGIN_URL (or --instance-url) must be an https:// Salesforce address, e.g. https://test.salesforce.com or your My Domain.'); }
  if (!lib.has('sf')) fail('the Salesforce CLI is not installed: run `sf-sdlc setup --install-tools` first.');
  const args = ['org', 'login', 'web', '--alias', alias, ...(url ? ['--instance-url', url] : [])];
  process.stderr.write(`Opening the Salesforce sign-in page in your browser for alias "${alias}"${url ? ' (address from .env)' : ''}. Sign in there; this waits until you finish.\n`);
  const r = lib.run('sf', args, { cwd: root, timeout: 900000 });
  if (r.status !== 0) fail(`sign-in did not complete: ${(r.stderr || r.stdout).replace(/\s+/g, ' ').trim().slice(0, 300)}`);
  try { fs.rmSync(path.join(lib.stateDir(root), 'org-list.cache.json'), { force: true }); } catch { /* no cache */ }
  const c = lib.classifyOrg(alias, cfg, root);
  return out({ ok: true, alias, kind: c.kind }, `Signed in: ${alias} (${c.kind}). Next: sf-sdlc setup --org ${alias}`);
}

// The copy-in folder registers the hosted MCP servers in the project's .mcp.json (the plugin ships
// its own). Existing entries are never overwritten.
function mergeMcpServers(done, skipped) {
  const tpl = lib.readJson(path.join(lib.KIT_ROOT, 'templates', 'mcp.json'));
  if (!tpl) return;
  const file = path.join(root, '.mcp.json');
  const exists = fs.existsSync(file);
  const cur = exists ? lib.readJson(file) : { mcpServers: {} };
  if (!cur) { skipped.push('.mcp.json (not valid JSON; add the sf-* servers by hand from .claude/templates/mcp.json)'); return; }
  cur.mcpServers = cur.mcpServers || {};
  const added = Object.keys(tpl.mcpServers).filter((k) => !cur.mcpServers[k]);
  if (!added.length) { skipped.push('.mcp.json (hosted MCP servers already registered)'); return; }
  for (const k of added) cur.mcpServers[k] = tpl.mcpServers[k];
  fs.writeFileSync(file, JSON.stringify(cur, null, 2) + '\n');
  done.push(`.mcp.json (+${added.join(', ')})`);
}

// ------------------------------------------------------------------ mcp

async function mcpCmd() {
  const sub = pos[1] || 'status';
  if (sub === 'list') {
    const on = mcp.enabledServers(cfg);
    const rows = Object.entries(mcp.HOSTED_SERVERS).map(([n, s]) => ({ name: n, server: `sf-${n}`, enabled: on.includes(n), canChangeOrg: s.writes, summary: s.summary }));
    return out({ org: mcp.mcpOrg(root, cfg) || null, servers: rows }, () => `Org: ${mcp.mcpOrg(root, cfg) || '(none)'}\n` + rows.map((r) => `${r.enabled ? '✔' : '•'} ${r.server.padEnd(22)} ${r.summary}${r.canChangeOrg ? ' — can change the org; every change asks first' : ''}`).join('\n'));
  }
  if (sub === 'enable' || sub === 'disable') {
    const want = pos.slice(2);
    if (!want.length) fail(`usage: sf-sdlc mcp ${sub} <server...>  (known: ${Object.keys(mcp.HOSTED_SERVERS).join(', ')})`);
    for (const n of want) if (!mcp.HOSTED_SERVERS[n]) fail(`unknown server "${n}" (known: ${Object.keys(mcp.HOSTED_SERVERS).join(', ')})`);
    saveConfig((c) => {
      c.mcp = c.mcp || {};
      const cur = Array.isArray(c.mcp.servers) ? c.mcp.servers : mcp.enabledServers(cfg);
      c.mcp.servers = sub === 'enable' ? [...new Set([...cur, ...want])] : cur.filter((n) => !want.includes(n));
    });
    const on = mcp.enabledServers(cfg);
    return out({ ok: true, servers: on }, `mcp.servers: ${on.join(', ') || '(none)'}\nTurn each one on in the org (Setup → MCP Servers), then restart Claude Code.`);
  }
  if (sub !== 'status') fail('usage: sf-sdlc mcp status|list|enable|disable [server...]');
  const names = pos.slice(2).length ? pos.slice(2) : mcp.enabledServers(cfg);
  for (const n of names) if (!mcp.HOSTED_SERVERS[n]) fail(`unknown server "${n}" (known: ${Object.keys(mcp.HOSTED_SERVERS).join(', ')})`);
  if (!names.length) fail('no hosted MCP servers are enabled: add names to mcp.servers in .claude/sf-sdlc.json');
  const org = mcp.mcpOrg(root, cfg);
  if (!org) fail('no target org: set mcp.org in .claude/sf-sdlc.json or run `sf config set target-org <alias>`');
  const kind = lib.classifyOrg(org, cfg, root).kind;
  const results = [];
  for (const n of names) results.push(await mcp.probe(n, root, cfg, org));
  const hint = { inactive: 'turn it on in Setup → MCP Servers (API Catalog), wait two minutes', auth: 'check the sf CLI login and the user\'s API access', unreachable: 'check the network and the org' };
  const ok = results.every((r) => r.state === 'ok');
  out({ ok, org, orgKind: kind, servers: results }, () => `Org: ${org} (${kind})\n` + results.map((r) => `${r.state === 'ok' ? '✔' : '✘'} sf-${r.name.padEnd(19)} ${r.state}${r.state === 'ok' ? ` — ${r.tools.length} tools: ${r.tools.join(', ')}` : ` — ${r.detail}\n    fix: ${hint[r.state] || ''}`}`).join('\n') + '\n\nRestart Claude Code after changing servers in the org or in mcp.servers.');
  process.exit(ok ? 0 : 1);
}

// ------------------------------------------------------------------ detect / skills

function detect() {
  const inv = ops.inventory(root, cfg);
  const proj = lib.sfdxProject(root);
  const exists = (p) => fs.existsSync(path.join(root, p));
  return {
    isSfdxProject: Boolean(proj), greenfield: Boolean(proj) && inv.total === 0, apiVersion: inv.apiVersion,
    packageDirectories: inv.packageDirectories, namespace: (proj && proj.namespace) || '',
    packaging: Boolean(proj && proj.packageAliases && Object.keys(proj.packageAliases).length),
    folders: inv.folders, counts: inv.counts, total: inv.total,
    rootFiles: ['package.json', 'jest.config.js', 'config/project-scratch-def.json', '.github/workflows', 'bitbucket-pipelines.yml', '.gitlab-ci.yml', 'azure-pipelines.yml', 'Jenkinsfile', 'code-analyzer.yml', '.forceignore'].filter(exists),
    docs: { brd: exists(path.join(cfg.paths.docs, '01-brd/BRD.md')), backlog: exists(path.join(cfg.paths.docs, '02-backlog/backlog.md')), hld: exists(path.join(cfg.paths.docs, '03-architecture/HLD.md')) },
  };
}

function catalog() {
  const c = lib.readJson(path.join(lib.KIT_ROOT, 'catalog', 'skills.json'));
  if (!c) fail('catalog/skills.json not found in the kit. Rebuild it with scripts/build-claude-plugin.py.');
  return c.skills;
}
const libraryDir = () => path.join(lib.KIT_ROOT, 'skill-library');
const projectSkills = () => path.join(root, '.claude', 'skills');
const lockPath = () => path.join(root, '.claude', 'sf-sdlc.skills.lock.json');
const readLock = () => lib.readJson(lockPath()) || { skills: {} };
const writeLock = (l) => fs.writeFileSync(lockPath(), JSON.stringify(l, null, 2) + '\n');

function skillDescription(dir) {
  try {
    const m = /^description:\s*(.*)$/m.exec(fs.readFileSync(path.join(dir, 'SKILL.md'), 'utf8').split(/^---\s*$/m)[1] || '');
    return m ? m[1].replace(/^["']|["']$/g, '') : '';
  } catch { return ''; }
}

// The mandatory set every project gets (detection rules with when.core): named skills plus every
// library skill matching a listed prefix (all official platform-* skills).
function coreSkills() {
  const rules = lib.readJson(path.join(lib.KIT_ROOT, 'catalog', 'detection-rules.json'));
  const cat = lib.readJson(path.join(lib.KIT_ROOT, 'catalog', 'skills.json'));
  const names = ((cat && cat.skills) || []).map((x) => x.name);
  const set = new Set();
  for (const r of (rules && rules.rules) || []) {
    if (!(r.when && r.when.core)) continue;
    for (const n of r.skills || []) set.add(n);
    for (const pre of r.skillPrefixes || []) for (const n of names) if (n.startsWith(pre)) set.add(n);
  }
  return set;
}

function skillsState() {
  const lock = readLock();
  const installed = [];
  let listingChars = 0;
  let entries = [];
  try { entries = fs.readdirSync(projectSkills(), { withFileTypes: true }).filter((e) => e.isDirectory() && fs.existsSync(path.join(projectSkills(), e.name, 'SKILL.md'))); } catch { /* none */ }
  const core = coreSkills();
  let coreChars = 0;
  for (const e of entries) {
    const dir = path.join(projectSkills(), e.name);
    const locked = lock.skills[e.name];
    const state = !locked ? 'unmanaged' : lib.hashDir(dir) === locked.hash ? 'ok' : 'modified';
    const c = Math.min(skillDescription(dir).length, 1536) + e.name.length;
    listingChars += c;
    if (core.has(e.name)) coreChars += c;
    installed.push({ name: e.name, state, source: locked && locked.source, core: core.has(e.name) });
  }
  return { installed, listingChars, coreChars, onDemandChars: listingChars - coreChars };
}

function recommendData(profile) {
  const rules = lib.readJson(path.join(lib.KIT_ROOT, 'catalog', 'detection-rules.json'));
  if (!rules) fail('catalog/detection-rules.json not found in the kit.');
  const d = detect();
  const names = new Set(catalog().map((s) => s.name));
  const have = new Set(skillsState().installed.map((s) => s.name));
  const picks = new Map();
  for (const rule of rules.rules) {
    const w = rule.when || {};
    let evidence = null;
    if (w.core) evidence = 'core set (every project)';
    else if (profile) { if ((w.profiles || []).includes(profile)) evidence = `profile "${profile}"`; }
    else if (w.always && d.isSfdxProject) evidence = 'Salesforce DX project';
    else if (w.greenfield && d.greenfield) evidence = 'empty project (greenfield starter set)';
    else if (w.folders && w.folders.some((f) => d.folders.includes(f))) evidence = `metadata folder(s): ${w.folders.filter((f) => d.folders.includes(f)).join(', ')}`;
    else if (w.rootFiles && w.rootFiles.some((f) => d.rootFiles.includes(f))) evidence = `file(s): ${w.rootFiles.filter((f) => d.rootFiles.includes(f)).join(', ')}`;
    else if (w.packaging && d.packaging) evidence = 'packageAliases in sfdx-project.json';
    else if (w.mcpServers && w.mcpServers.some((n) => mcp.enabledServers(cfg).includes(n))) evidence = `hosted MCP server enabled in mcp.servers: ${w.mcpServers.filter((n) => mcp.enabledServers(cfg).includes(n)).join(', ')}`;
    if (!evidence) continue;
    const prefixed = (rule.skillPrefixes || []).flatMap((pre) => [...names].filter((n) => n.startsWith(pre)).sort());
    for (const s of [...new Set([...(rule.skills || []), ...prefixed])]) {
      if (!names.has(s)) continue;
      const p = picks.get(s) || { name: s, rule: rule.id, core: Boolean(w.core), primary: (rule.skills || [])[0] === s, kind: w.core ? 'core' : /^(Salesforce DX project|profile)/.test(evidence) ? 'base' : /^hosted MCP/.test(evidence) ? 'mcp' : 'code', reasons: [], installed: have.has(s) };
      p.reasons.push(`${rule.reason} [${evidence}]`);
      picks.set(s, p);
    }
  }
  return { d, ordered: [...picks.values()] };
}

function recommend() {
  const profile = flags['--profile'];
  const { d, ordered } = recommendData(profile);
  const list = ordered.slice().sort((a, b) => a.name.localeCompare(b.name));
  const toInstall = list.filter((p) => !p.installed).map((p) => p.name);
  out({ profile: profile || null, detected: { greenfield: d.greenfield, folders: d.folders, counts: d.counts }, recommended: list, toInstall, installCommand: toInstall.length ? `sf-sdlc skills install ${toInstall.join(' ')}` : null, note: 'Detection reads the source tree only. Add skills for org-only features and planned work by name; see `sf-sdlc skills list --all`.' },
    () => (list.length ? list.map((p) => `${p.installed ? '✔' : '+'} ${p.name}\n    ${p.reasons.join('\n    ')}`).join('\n') : 'No technical skills recommended (no Salesforce source detected). Use --profile developer|admin|ba to pick a starter set.') +
      (toInstall.length ? `\n\nInstall: sf-sdlc skills install ${toInstall.join(' ')}` : ''));
}

function copyDir(src, dest) { fs.cpSync(src, dest, { recursive: true }); }

function installSkills(names) {
    const lock = readLock();
    const res = [];
    const cat = new Map(catalog().map((s) => [s.name, s]));
    for (const n of names) {
      const src = path.join(libraryDir(), n);
      const dest = path.join(projectSkills(), n);
      if (!fs.existsSync(path.join(src, 'SKILL.md'))) { res.push({ name: n, result: cat.has(n) && cat.get(n).location === 'skills' ? 'already part of the kit (always loaded)' : 'not found in the skill library' }); continue; }
      if (fs.existsSync(dest) && !flags['--force']) { res.push({ name: n, result: 'already installed (use --force to replace)' }); continue; }
      fs.rmSync(dest, { recursive: true, force: true });
      fs.mkdirSync(projectSkills(), { recursive: true });
      copyDir(src, dest);
      lock.skills[n] = { hash: lib.hashDir(dest), source: (cat.get(n) || {}).source || 'unknown', installedAt: new Date().toISOString().slice(0, 10) };
      res.push({ name: n, result: 'installed' });
    }
    writeLock(lock);
    return res;
}

function skillsCmd() {
  const sub = pos[1] || 'list';
  const names = pos.slice(2);
  if (sub === 'recommend') return recommend();
  if (sub === 'list') {
    const st = skillsState();
    if (flags['--all']) {
      const inst = new Set(st.installed.map((s) => s.name));
      const all = catalog().map((s) => ({ ...s, installed: inst.has(s.name) }));
      return out({ skills: all }, () => all.map((s) => `${s.installed ? '✔' : ' '} ${s.name.padEnd(48)} ${s.source.padEnd(10)} ${s.description.slice(0, 90)}`).join('\n'));
    }
    return out(st, () => (st.installed.map((s) => `${s.name.padEnd(48)} ${s.state}`).join('\n') || '(no project skills)') + `\n\n${st.installed.length} skills, about ${st.listingChars} description characters.`);
  }
  if (sub === 'install') {
    if (!names.length) fail('usage: sf-sdlc skills install <name> [<name>...]');
    const res = installSkills(names);
    const st = skillsState();
    return out({ results: res, listingChars: st.listingChars }, () => res.map((r) => `${r.name}: ${r.result}`).join('\n') + `\n\nRestart the Claude Code session (or run /reload-plugins) so new skills are listed. Listing size: about ${st.listingChars} characters.`);
  }
  if (sub === 'remove') {
    const lock = readLock();
    const res = [];
    for (const n of names) {
      const dest = path.join(projectSkills(), n);
      if (!fs.existsSync(dest)) { res.push({ name: n, result: 'not installed' }); continue; }
      if (!lock.skills[n] && !flags['--force']) { res.push({ name: n, result: 'not installed by sf-sdlc; left alone (use --force)' }); continue; }
      if (lock.skills[n] && lib.hashDir(dest) !== lock.skills[n].hash && !flags['--force']) { res.push({ name: n, result: 'locally modified; left alone (use --force)' }); continue; }
      fs.rmSync(dest, { recursive: true, force: true }); delete lock.skills[n];
      res.push({ name: n, result: 'removed' });
    }
    writeLock(lock);
    return out({ results: res }, () => res.map((r) => `${r.name}: ${r.result}`).join('\n'));
  }
  if (sub === 'sync') {
    const lock = readLock();
    const res = [];
    for (const [n, entry] of Object.entries(lock.skills)) {
      const src = path.join(libraryDir(), n);
      const dest = path.join(projectSkills(), n);
      if (!fs.existsSync(dest)) { delete lock.skills[n]; res.push({ name: n, result: 'no longer installed; dropped from lock' }); continue; }
      if (!fs.existsSync(src)) { res.push({ name: n, result: 'no longer in the library; kept as is' }); continue; }
      const cur = lib.hashDir(dest);
      const latest = lib.hashDir(src);
      if (cur === latest) { res.push({ name: n, result: 'up to date' }); continue; }
      if (cur !== entry.hash && !flags['--force']) { res.push({ name: n, result: 'locally modified AND a newer version exists; not overwritten (review, then --force)' }); continue; }
      if (flags['--dry-run']) { res.push({ name: n, result: 'update available' }); continue; }
      fs.rmSync(dest, { recursive: true, force: true }); copyDir(src, dest);
      lock.skills[n] = { ...entry, hash: latest, installedAt: new Date().toISOString().slice(0, 10) };
      res.push({ name: n, result: 'updated' });
    }
    if (!flags['--dry-run']) writeLock(lock);
    return out({ results: res }, () => res.map((r) => `${r.name}: ${r.result}`).join('\n') || 'No skills are managed by sf-sdlc yet.');
  }
  fail(`unknown skills subcommand "${sub}"`);
}

// ------------------------------------------------------------------ analyze / check

function analyzeCmd() {
  let targets = pos.slice(1);
  if (flags['--staged']) targets = (ops.stagedFiles(root, false) || []).filter(ops.isSalesforceSource);
  else if (flags['--changed'] !== undefined) {
    const ch = ops.changedFiles(root, typeof flags['--changed'] === 'string' ? flags['--changed'] : undefined);
    targets = ch ? ch.rows.filter((r) => r.status !== 'D').map((r) => r.file).filter(ops.isSalesforceSource) : [];
  } else if (!targets.length) targets = lib.packageDirs(root, cfg);
  targets = targets.filter((t) => fs.existsSync(path.join(root, t)));
  if (!targets.length) return out({ ran: false, passed: true, reason: 'no Salesforce source files in scope' }, 'Nothing to scan: no Salesforce source files in scope.');
  const outputFiles = flags['--report'] ? String(flags['--report']).split(',') : [];
  const res = ops.analyze(root, cfg, targets, { severity: flags['--severity'], ruleSelector: flags['--rule-selector'], outputFiles });
  if (!res.ran) fail(`${res.reason}${res.detail ? '\n' + res.detail : ''}`, 2);
  out({ ...res, targets: targets.length }, () => `Salesforce Code Analyzer — ${targets.length} target(s), rules "${res.ruleSelector}", blocking severity ≤ ${res.threshold}\n` +
    `violations: ${res.counts.total} (sev1 ${res.counts.sev1}, sev2 ${res.counts.sev2}, sev3 ${res.counts.sev3}, sev4 ${res.counts.sev4}, sev5 ${res.counts.sev5})\n` +
    (res.violations.length ? ops.formatViolations(res.violations, flags['--all'] ? 1000 : 50) + '\n' : '') +
    (res.passed ? 'PASS' : `FAIL — ${res.blocking.length} violation(s) at severity ${res.threshold} or worse`));
  process.exit(res.passed ? 0 : 1);
}

function checkCmd() {
  let files = pos.slice(1);
  if (!files.length) { const ch = ops.changedFiles(root); files = ch ? ch.rows.filter((r) => r.status !== 'D').map((r) => r.file) : []; }
  const all = [];
  for (const f of files) {
    let src;
    try { src = fs.readFileSync(path.join(root, f), 'utf8'); } catch { continue; }
    for (const x of checks.checkFile(f, src, { apiVersion: lib.apiVersion(root, cfg) })) all.push({ file: f, ...x });
    for (const s of checks.findSecrets(src)) all.push({ file: f, rule: 'secret-' + s, severity: 'blocker', line: 1, message: 'Credential in source.' });
  }
  const blocking = all.filter((x) => x.severity === 'blocker');
  out({ files: files.length, findings: all, passed: blocking.length === 0 }, () => (all.map((x) => `${x.severity.toUpperCase().padEnd(7)} ${x.file}:${x.line} [${x.rule}] ${x.message}`).join('\n') || 'No findings.') + `\n${files.length} file(s) checked.`);
  process.exit(blocking.length ? 1 : 0);
}

// ------------------------------------------------------------------ deploy / test

function requireOrg() {
  const target = lib.resolveOrg(flags['--org'], cfg) || lib.defaultOrg(root);
  if (!target) fail('no target org: pass --org <role or alias>, or set a default org');
  return { target, org: lib.classifyOrg(target, cfg, root), role: Object.keys(cfg.orgs).find((r) => cfg.orgs[r] === target) || (cfg.orgs.production.includes(target) ? 'production' : undefined) };
}
const jobsFile = () => path.join(lib.stateDir(root), 'jobs.json');
const readJobs = () => lib.readJson(jobsFile()) || [];
function saveJob(job) { const jobs = readJobs().filter((j) => j.id !== job.id); jobs.push(job); fs.writeFileSync(jobsFile(), JSON.stringify(jobs.slice(-50), null, 2)); }

function sourceArgs() {
  if (flags['--manifest']) return ['--manifest', flags['--manifest']];
  if (flags['--source-dir']) return String(flags['--source-dir']).split(',').flatMap((d) => ['--source-dir', d]);
  if (flags['--delta'] || (cfg.deploy.useDelta && flags['--from'])) {
    const d = ops.delta(root, cfg, flags['--from']);
    if (d.error) fail(d.error);
    const dir = path.join(lib.stateDir(root), 'delta');
    fs.mkdirSync(dir, { recursive: true });
    const api = lib.apiVersion(root, cfg);
    fs.writeFileSync(path.join(dir, 'package.xml'), ops.packageXml([...d.new, ...d.changed], api));
    const args = ['--manifest', path.relative(root, path.join(dir, 'package.xml'))];
    if (d.removed.length) {
      if (!flags['--with-destructive']) fail(`the delta removes ${d.removed.length} component(s): ${d.removed.map((c) => c.type + ':' + c.apiName).join(', ')}. Deleting metadata can delete data. Re-run with --with-destructive after a person has approved the list.`);
      fs.writeFileSync(path.join(dir, 'destructiveChanges.xml'), ops.packageXml(d.removed, api));
      args.push('--post-destructive-changes', path.relative(root, path.join(dir, 'destructiveChanges.xml')));
    }
    if (!d.new.length && !d.changed.length && !d.removed.length) fail(`no metadata changes against ${d.base}`);
    return args;
  }
  return lib.packageDirs(root, cfg).flatMap((d) => ['--source-dir', d]);
}

function execSf(args, summary) {
  if (flags['--print']) return out({ command: 'sf ' + args.join(' ') }, 'sf ' + args.join(' '));
  const r = lib.sfJson(args, { cwd: root, timeout: (Number(flags['--wait']) || cfg.deploy.waitMinutes) * 60000 + 120000 });
  if (!r.json) fail(`sf produced no JSON (exit ${r.status}).\n${(r.stderr || r.stdout).split('\n').slice(-20).join('\n')}`, 2);
  return summary(r.json);
}

function deploySummary(j, target, kind, action) {
  const res = j.result || {};
  const failures = ((res.details && res.details.componentFailures) || []);
  const list = (Array.isArray(failures) ? failures : [failures]).map((f) => ({ type: f.componentType, name: f.fullName, problem: f.problem, line: f.lineNumber }));
  const tests = (res.details && res.details.runTestResult) || {};
  const data = {
    ok: j.status === 0 && !['Failed', 'Canceled'].includes(res.status), action, targetOrg: target, orgKind: kind,
    jobId: res.id, status: res.status || (j.status === 0 ? 'Submitted' : 'Failed'),
    components: { total: res.numberComponentsTotal, deployed: res.numberComponentsDeployed, errors: res.numberComponentErrors },
    tests: { total: res.numberTestsTotal, completed: res.numberTestsCompleted, errors: res.numberTestErrors, failures: [].concat(tests.failures || []).map((f) => ({ name: f.name, method: f.methodName, message: f.message })) },
    componentFailures: list, error: j.status !== 0 ? j.message : undefined,
  };
  if (data.jobId) saveJob({ id: data.jobId, type: action, org: target, status: data.status, at: new Date().toISOString() });
  lib.appendJsonl(path.join(lib.stateDir(root), 'deployments.jsonl'), { at: new Date().toISOString(), ...data });
  out(data, () => `${action} → ${target} (${kind}): ${data.status}${data.jobId ? `  job ${data.jobId}` : ''}\n` +
    (list.length ? list.map((f) => `  ✘ ${f.type} ${f.name}${f.line ? ':' + f.line : ''} — ${f.problem}`).join('\n') + '\n' : '') +
    (data.tests.failures.length ? data.tests.failures.map((f) => `  ✘ test ${f.name}.${f.method} — ${f.message}`).join('\n') + '\n' : '') +
    (data.error ? `  ${data.error}\n` : '') +
    (action === 'validate' && data.ok ? `Next: sf-sdlc deploy report --job-id ${data.jobId}   then, when Succeeded and approved: sf-sdlc deploy quick --org ${flags['--org'] || target}` : ''));
  process.exit(data.ok ? 0 : 1);
}

function deployCmd() {
  const sub = pos[1];
  if (sub === 'report') {
    const id = flags['--job-id'] || (readJobs().filter((j) => j.type !== 'test').slice(-1)[0] || {}).id;
    if (!id) fail('no job id: pass --job-id');
    const job = readJobs().find((j) => j.id === id) || {};
    const args = ['project', 'deploy', 'report', '--job-id', id];
    if (job.org) args.push('--target-org', job.org);
    if (flags['--wait']) args.push('--wait', String(flags['--wait']));
    return execSf(args, (j) => deploySummary(j, job.org || '(org of the job)', job.org ? lib.classifyOrg(job.org, cfg, root).kind : 'unknown', job.type || 'deploy'));
  }
  const { target, org, role } = requireOrg();
  if (org.kind === 'production' && !flags['--confirmed-production']) {
    fail(`"${target}" is a production org. Run this only after the person has named the org and confirmed, then add --confirmed-production. The guard hook will ask them again.`);
  }
  if (sub === 'validate') {
    let level = flags['--level'] || cfg.deploy.testLevel[role] || 'RunLocalTests';
    if (level === 'NoTestRun') level = 'RunLocalTests'; // a validation that runs no tests cannot be quick-deployed
    const args = ['project', 'deploy', 'validate', '--target-org', target, '--test-level', level, ...sourceArgs()];
    if (level === 'RunSpecifiedTests') for (const t of String(flags['--tests'] || '').split(',').filter(Boolean)) args.push('--tests', t);
    if (flags['--wait']) args.push('--wait', String(flags['--wait'])); else args.push('--async');
    return execSf(args, (j) => deploySummary(j, target, org.kind, 'validate'));
  }
  if (sub === 'quick') {
    const id = flags['--job-id'] || (readJobs().filter((j) => j.type === 'validate' && j.org === target).slice(-1)[0] || {}).id;
    if (!id) fail(`no validated job recorded for "${target}". Run \`sf-sdlc deploy validate --org ${flags['--org'] || target}\` first, or pass --job-id.`);
    return execSf(['project', 'deploy', 'quick', '--job-id', id, '--target-org', target, '--wait', String(flags['--wait'] || 30)], (j) => deploySummary(j, target, org.kind, 'quick'));
  }
  if (sub === 'preview') {
    return execSf(['project', 'deploy', 'start', '--dry-run', '--target-org', target, '--test-level', flags['--level'] || 'NoTestRun', ...sourceArgs(), '--wait', String(flags['--wait'] || 30)], (j) => deploySummary(j, target, org.kind, 'preview'));
  }
  fail('usage: sf-sdlc deploy validate|quick|report|preview --org <role or alias> [--delta --from <ref>] [--manifest <file>] [--level <test level>] [--print]');
}

function testSummary(j, target) {
  const res = j.result || {};
  const s = res.summary || {};
  const pct = (v) => (v === undefined || v === null ? null : parseFloat(String(v)));
  const failures = (res.tests || []).filter((t) => /fail|compile/i.test(t.Outcome || '')).map((t) => ({ test: t.FullName || `${(t.ApexClass || {}).Name}.${t.MethodName}`, message: t.Message, stack: t.StackTrace }));
  const classes = ((res.coverage && res.coverage.coverage) || []).map((c) => ({ name: c.name, percent: c.coveredPercent, uncoveredLines: c.totalLines - c.totalCovered }));
  const target_ = cfg.quality.coverageTarget;
  const below = classes.filter((c) => typeof c.percent === 'number' && c.percent < target_).sort((a, b) => a.percent - b.percent);
  const orgWide = pct(s.orgWideCoverage);
  const data = {
    ok: j.status === 0 && failures.length === 0 && /pass/i.test(s.outcome || '') && below.length === 0,
    targetOrg: target, runId: s.testRunId, outcome: s.outcome || (j.status === 0 ? 'Unknown' : 'Failed'),
    ran: s.testsRan, passing: s.passing, failing: s.failing, skipped: s.skipped,
    coverage: { run: pct(s.testRunCoverage), orgWide, target: target_, orgMinimum: cfg.quality.orgCoverageMinimum, orgWideOk: orgWide === null ? null : orgWide >= cfg.quality.orgCoverageMinimum, classesBelowTarget: below },
    failures, error: j.status !== 0 && !s.outcome ? j.message : undefined,
  };
  const dir = path.join(lib.stateDir(root), 'test-runs');
  fs.mkdirSync(dir, { recursive: true });
  const file = path.join(dir, `${new Date().toISOString().replace(/[:.]/g, '-')}.json`);
  fs.writeFileSync(file, JSON.stringify({ summary: data, raw: j }, null, 2));
  data.savedTo = path.relative(root, file);
  if (data.runId && !s.outcome) saveJob({ id: data.runId, type: 'test', org: target, status: 'Queued', at: new Date().toISOString() });
  out(data, () => `Apex tests on ${target}: ${data.outcome} — ran ${data.ran ?? '?'}, passed ${data.passing ?? '?'}, failed ${data.failing ?? '?'}\n` +
    `coverage: run ${data.coverage.run ?? '?'}%, org-wide ${orgWide ?? '?'}% (class target ${target_}%, org minimum ${cfg.quality.orgCoverageMinimum}%)\n` +
    (failures.length ? failures.map((f) => `  ✘ ${f.test} — ${f.message}`).join('\n') + '\n' : '') +
    (below.length ? `classes below ${target_}%:\n` + below.map((c) => `  ${String(c.percent).padStart(3)}%  ${c.name}`).join('\n') + '\n' : '') +
    (data.error ? data.error + '\n' : '') + `raw result: ${data.savedTo}\n${data.ok ? 'PASS' : 'FAIL'}`);
  process.exit(data.ok ? 0 : 1);
}

function testCmd() {
  const sub = pos[1];
  if (sub === 'report') {
    const id = flags['--run-id'] || (readJobs().filter((j) => j.type === 'test').slice(-1)[0] || {}).id;
    if (!id) fail('no test run id: pass --run-id');
    const job = readJobs().find((j) => j.id === id) || {};
    const target = lib.resolveOrg(flags['--org'], cfg) || job.org || lib.defaultOrg(root);
    return execSf(['apex', 'get', 'test', '--test-run-id', id, '--code-coverage', '--result-format', 'json', ...(target ? ['--target-org', target] : [])], (j) => testSummary(j, target));
  }
  if (sub !== 'run') fail('usage: sf-sdlc test run|report --org <role or alias> [--tests ClassA,ClassB.method] [--level RunLocalTests] [--wait <minutes>]');
  const { target, org } = requireOrg();
  if (org.kind === 'production') fail(`"${target}" is a production org. Tests are run in sandboxes and scratch orgs; production tests run as part of a validated deployment.`);
  const args = ['apex', 'run', 'test', '--target-org', target, '--code-coverage', '--result-format', 'json', '--wait', String(flags['--wait'] || 10)];
  const tests = String(flags['--tests'] || '').split(',').filter(Boolean);
  if (tests.length) for (const t of tests) args.push('--tests', t);
  else args.push('--test-level', flags['--level'] || 'RunLocalTests');
  return execSf(args, (j) => testSummary(j, target));
}

// ------------------------------------------------------------------ small commands

function watchJobs() {
  // Monitor process: prints one line whenever a tracked deploy or test job changes state.
  const seen = new Map();
  const tick = () => {
    for (const job of readJobs()) {
      if (flags['--type'] && (job.type === 'test') !== (flags['--type'] === 'test')) continue;
      if (['Succeeded', 'Failed', 'Canceled', 'Passed', 'Completed'].includes(seen.get(job.id) || job.status)) { seen.set(job.id, seen.get(job.id) || job.status); continue; }
      const args = job.type === 'test' ? ['apex', 'get', 'test', '--test-run-id', job.id, '--result-format', 'json'] : ['project', 'deploy', 'report', '--job-id', job.id];
      if (job.org) args.push('--target-org', job.org);
      const r = lib.sfJson(args, { cwd: root, timeout: 120000 });
      const res = (r.json && r.json.result) || {};
      const status = job.type === 'test' ? ((res.summary && res.summary.outcome) || 'Running') : (res.status || 'Unknown');
      if (status !== seen.get(job.id)) {
        seen.set(job.id, status);
        if (status !== job.status) { saveJob({ ...job, status }); process.stdout.write(`sf-sdlc: ${job.type} job ${job.id} on ${job.org || 'default org'} is now ${status}${res.numberComponentErrors ? ` (${res.numberComponentErrors} component error(s))` : ''}${res.numberTestErrors ? ` (${res.numberTestErrors} test error(s))` : ''}. Details: sf-sdlc ${job.type === 'test' ? 'test report --run-id' : 'deploy report --job-id'} ${job.id}\n`); }
      }
    }
  };
  tick();
  setInterval(tick, 30000);
}

function diagram() {
  const file = pos[2];
  const sub = pos[1];
  if (sub === 'drawio') return diagramDrawio(file);
  if (sub === 'export') return diagramExport(file);
  if (sub === 'check') return diagramCheck(file);
  if (sub !== 'render' || !file) fail('usage: sf-sdlc diagram render <file.mmd | file.md> | drawio <spec.json | components.json> | export <file.drawio> | check <file.drawio>');
  if (!lib.has('mmdc')) fail('mermaid-cli (mmdc) is not installed. Install with: npm install --global @mermaid-js/mermaid-cli. Mermaid blocks still render natively on GitHub.', 2);
  const output = flags['--output'] || file.replace(/\.(mmd|md)$/, '') + '.svg';
  const r = lib.run('mmdc', ['-i', file, '-o', output, '-b', 'transparent'], { cwd: root, timeout: 180000 });
  if (r.status !== 0) fail(`mmdc failed:\n${(r.stderr || r.stdout).split('\n').slice(-10).join('\n')}`);
  out({ ok: true, output }, `rendered ${output}`);
}

// A diagram spec (*.diagram.json) or the component model (components.json) -> an editable .drawio file.
function diagramDrawio(file) {
  if (!file) fail('usage: sf-sdlc diagram drawio <spec.json | components.json> [--type solution-architecture|data-model] [--story US-nn-mm] [--layer <layer>] [--title "..."] [--output <file.drawio>]');
  const abs = path.resolve(root, file);
  const input = lib.readJson(abs);
  if (!input) fail(`${file} is missing or is not valid JSON`);
  let spec = input;
  if (Array.isArray(input)) {
    try {
      spec = diagramLib.specFromComponents(input, { type: flags['--type'], story: flags['--story'], layer: flags['--layer'], title: flags['--title'] });
    } catch (e) { fail(e.message); }
  }
  const v = diagramLib.validateSpec(spec);
  if (v.errors.length) fail(`the diagram spec has errors:\n${v.errors.map((e) => `  ✘ ${e}`).join('\n')}`);
  const base = Array.isArray(input)
    ? path.join(path.dirname(abs), 'diagrams', `${diagramLib.normaliseType(spec.type)}${flags['--story'] ? `-${flags['--story']}` : ''}`)
    : abs.replace(/(\.diagram)?\.json$/, '');
  const output = flags['--output'] ? path.resolve(root, flags['--output']) : `${base}.drawio`;
  fs.mkdirSync(path.dirname(output), { recursive: true });
  // Keep the generated spec next to the diagram: it is the editable source of the drawing.
  if (Array.isArray(input)) fs.writeFileSync(output.replace(/\.drawio$/, '.diagram.json'), JSON.stringify(spec, null, 2) + '\n');
  fs.writeFileSync(output, diagramLib.toDrawio(spec));
  const check = diagramLib.checkDrawio(fs.readFileSync(output, 'utf8'));
  const rel = path.relative(root, output);
  out({ ok: true, output: rel, warnings: v.warnings.concat(check.warnings), problems: check.problems, stats: check.stats },
    [`wrote ${rel} (${check.stats.cards} cards, ${check.stats.edges} connectors)`, ...v.warnings.concat(check.warnings).map((w) => `  • ${w}`), ...check.problems.map((p) => `  ✘ ${p}`),
      `Image: sf-sdlc diagram export ${rel} --format png`].join('\n'));
}

function diagramExport(file) {
  if (!file) fail('usage: sf-sdlc diagram export <file.drawio> [--format png|svg|pdf] [--output <file>]');
  const abs = path.resolve(root, file);
  if (!fs.existsSync(abs)) fail(`${file} not found`);
  const r = diagramLib.exportDrawio(abs, { format: flags['--format'] || 'png', output: flags['--output'] && path.resolve(root, flags['--output']) });
  if (!r.ok) fail(r.reason, 2);
  out({ ok: true, output: path.relative(root, r.output), tool: r.tool }, `exported ${path.relative(root, r.output)}`);
}

function diagramCheck(file) {
  if (!file) fail('usage: sf-sdlc diagram check <file.drawio>');
  const abs = path.resolve(root, file);
  if (!fs.existsSync(abs)) fail(`${file} not found`);
  const r = diagramLib.checkDrawio(fs.readFileSync(abs, 'utf8'));
  out({ ok: !r.problems.length, ...r }, () => [
    ...r.problems.map((p) => `✘ ${p}`), ...r.warnings.map((w) => `• ${w}`),
    r.problems.length ? `${r.problems.length} problem(s).` : `OK: ${r.stats.cards} cards, ${r.stats.edges} connectors, icons: ${(r.stats.salesforceIcons || []).join(', ') || 'none'}.`,
  ].join('\n'));
  if (r.problems.length) process.exit(1);
}

function audit() {
  const file = path.join(lib.stateDir(root), 'audit.jsonl');
  const rows = fs.existsSync(file) ? fs.readFileSync(file, 'utf8').split('\n').filter(Boolean).map((l) => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean) : [];
  const tail = rows.slice(-(Number(flags['--tail']) || 50));
  out({ file: path.relative(root, file), total: rows.length, entries: tail }, () => tail.map((r) => `${r.at}  ${String(r.outcome).padEnd(6)} ${String(r.orgKind).padEnd(10)} ${String(r.targetOrg).padEnd(20)} ${r.user}  ${r.command}`).join('\n') || 'No org-affecting commands recorded yet.');
}


// ------------------------------------------------------------------ setup

// Change the shared config file and reload it. Creates the file from the defaults when it is missing.
function saveConfig(mutate) {
  const file = lib.configPaths(root).shared;
  const cur = lib.readJson(file);
  if (fs.existsSync(file) && !cur) fail('.claude/sf-sdlc.json is not valid JSON; fix it first.');
  const c = cur || {};
  mutate(c);
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, JSON.stringify(c, null, 2) + '\n');
  cfg = lib.loadConfig(root);
}

// Tools the kit can install without an administrator password. Everything else is listed for the person.
const AUTO_INSTALL = {
  sf: ['npm', ['install', '--global', '@salesforce/cli']],
  'code-analyzer': ['sf', ['plugins', 'install', 'code-analyzer']],
  sgd: ['sf', ['plugins', 'install', 'sfdx-git-delta']],
  lfs: ['sf', ['plugins', 'install', 'lightning-flow-scanner']],
};

// Diagram tools: installed on a yes where the package manager needs no administrator password
// (Homebrew on macOS, winget on Windows). Linux package managers need sudo, so Linux gets the command.
function diagramToolInstall(id) {
  const accept = ['-e', '--accept-source-agreements', '--accept-package-agreements'];
  if (process.platform === 'darwin' && lib.has('brew')) return { drawio: ['brew', ['install', '--cask', 'drawio']], python: ['brew', ['install', 'python']] }[id] || null;
  if (process.platform === 'win32' && lib.has('winget')) return { drawio: ['winget', ['install', '--id', 'JGraph.Draw', ...accept]], python: ['winget', ['install', '--id', 'Python.Python.3.12', ...accept]] }[id] || null;
  return null;
}

const LINKS = {
  atlassianToken: 'https://id.atlassian.com/manage-profile/security/api-tokens',
  githubToken: 'https://github.com/settings/personal-access-tokens/new',
  gh: 'https://cli.github.com',
  node: 'https://nodejs.org/en/download',
  java: 'https://adoptium.net/temurin/releases/?version=17',
  uv: 'https://docs.astral.sh/uv/getting-started/installation/',
};

// One run that does everything that needs no decision, then reports a checklist: what is done, what
// Claude can do on a yes, and what only the person can do (with the link or command for each).
// Safe to run again at any time; it never overwrites a value or a file somebody edited.
async function setupCmd() {
  const profile = ['developer', 'admin', 'ba'].includes(flags['--profile']) ? flags['--profile'] : null;
  const offline = Boolean(flags['--offline']);
  const steps = [];
  // state: done | claude (Claude can do it on a yes) | you (only the person can) | optional | skipped
  const add = (area, item, state, detail, extra = {}) => steps.push({ area, item, state, detail: detail || '', ...extra });

  // 1. Git repository
  if (lib.has('git')) {
    if (lib.git(['rev-parse', '--is-inside-work-tree'], root) === 'true') add('Project', 'Git repository', 'done', `branch ${lib.git(['branch', '--show-current'], root) || '(no commits yet)'}`);
    else if (flags['--no-git']) add('Project', 'Git repository', 'optional', 'not a git repository (skipped: --no-git)');
    else {
      const ok = lib.git(['init', '-b', 'main'], root) !== null || lib.git(['init'], root) !== null;
      add('Project', 'Git repository', ok ? 'done' : 'you', ok ? 'created now (empty; nothing committed)' : 'could not create it', ok ? {} : { command: 'git init' });
    }
  }

  // 2. Project files
  const files = initRun();
  cfg = lib.loadConfig(root);
  add('Project', 'Kit files (settings, rules, config, .env template, .gitignore)', 'done', files.created.length ? `created ${files.created.length}: ${files.created.map((f) => f.split(' ')[0]).join(', ')}` : 'already in place');

  // 3. Tools
  const wantSf = profile !== 'ba';
  let rows = doctorRows();
  const installed = [];
  if (flags['--install-tools']) {
    for (const id of ['sf', 'code-analyzer', 'sgd', 'lfs']) {
      const row = rows.find((r) => r.id === id);
      if (!row || row.ok || !wantSf) continue;
      if (id !== 'sf' && !lib.has('sf')) continue;
      const [cmd, args] = AUTO_INSTALL[id];
      const r = lib.run(cmd, args, { cwd: root, timeout: 600000, input: 'y\n' });
      installed.push({ id, ok: r.status === 0, detail: r.status === 0 ? 'installed now' : (r.stderr || r.stdout).replace(/\s+/g, ' ').trim().slice(-200) });
    }
    for (const id of ['python', 'drawio']) {
      const row = rows.find((r) => r.id === id);
      const how = diagramToolInstall(id);
      if (!row || row.ok || !how) continue;
      const r = lib.run(how[0], how[1], { cwd: root, timeout: 900000 });
      installed.push({ id, ok: r.status === 0, detail: r.status === 0 ? 'installed now' : (r.stderr || r.stdout).replace(/\s+/g, ' ').trim().slice(-200) });
    }
    rows = doctorRows();
  }
  const os = process.platform === 'darwin' ? 'mac' : process.platform === 'win32' ? 'win' : 'linux';
  const manual = {
    node: { mac: 'brew install node', win: 'winget install OpenJS.NodeJS.LTS', linux: 'sudo apt-get install -y nodejs npm', url: LINKS.node },
    git: { mac: 'xcode-select --install', win: 'winget install Git.Git', linux: 'sudo apt-get install -y git' },
    java: { mac: 'brew install --cask temurin@17', win: 'winget install EclipseAdoptium.Temurin.17.JDK', linux: 'sudo apt-get install -y openjdk-17-jdk', url: LINKS.java },
    gh: { mac: 'brew install gh', win: 'winget install GitHub.cli', linux: 'sudo apt-get install -y gh', url: LINKS.gh },
    mermaid: { mac: 'npm install --global @mermaid-js/mermaid-cli', win: 'npm install --global @mermaid-js/mermaid-cli', linux: 'npm install --global @mermaid-js/mermaid-cli' },
    drawio: { mac: 'brew install --cask drawio', win: 'winget install JGraph.Draw', linux: 'sudo snap install drawio', url: 'https://www.drawio.com' },
    python: { mac: 'brew install python', win: 'winget install Python.Python.3.12', linux: 'sudo apt-get install -y python3', url: 'https://www.python.org/downloads/' },
  };
  const toolLabel = { node: 'Node.js 18+', git: 'git', sf: 'Salesforce CLI (sf)', 'code-analyzer': 'Salesforce Code Analyzer', java: 'Java 11+ (Code Analyzer engines)', sgd: 'sfdx-git-delta (smaller deployments)', lfs: 'Lightning Flow Scanner', gh: 'GitHub CLI (gh)', mermaid: 'mermaid-cli (diagram images)', drawio: 'draw.io desktop (Salesforce-style diagram images)', python: 'Python 3 (draw.io skill scripts)' };
  for (const id of ['node', 'git', 'sf', 'code-analyzer', 'java', 'sgd', 'lfs', 'gh', 'mermaid', 'python', 'drawio']) {
    const row = rows.find((r) => r.id === id);
    if (!row) continue;
    const did = installed.find((x) => x.id === id);
    const sfOnly = ['sf', 'code-analyzer', 'java', 'sgd', 'lfs'].includes(id);
    if (row.ok) add('Tools', toolLabel[id], 'done', did ? 'installed now' : row.detail);
    else if (diagramToolInstall(id)) { const how = diagramToolInstall(id); add('Tools', toolLabel[id], 'claude', did ? `install failed: ${did.detail}` : 'not installed — needed to export architecture diagrams', { command: `${how[0]} ${how[1].join(' ')}`, auto: true }); }
    else if (sfOnly && !wantSf) add('Tools', toolLabel[id], 'skipped', 'not needed for requirements work');
    else if (AUTO_INSTALL[id] && (id === 'sf' ? lib.has('npm') : lib.has('sf'))) add('Tools', toolLabel[id], id === 'sf' || id === 'code-analyzer' ? 'claude' : 'optional', did ? `install failed: ${did.detail}` : 'not installed', { command: `${AUTO_INSTALL[id][0]} ${AUTO_INSTALL[id][1].join(' ')}`, auto: true });
    else if (manual[id]) add('Tools', toolLabel[id], row.required || ['java', 'python', 'drawio'].includes(id) ? 'you' : 'optional', 'not installed', { command: manual[id][os], url: manual[id].url });
    else add('Tools', toolLabel[id], 'optional', 'not installed', { command: row.fix });
  }

  // 4. Salesforce org for this project
  try { fs.rmSync(path.join(lib.stateDir(root), 'org-list.cache.json'), { force: true }); } catch { /* no cache */ }
  const orgs = lib.has('sf') && !offline ? (lib.orgList(root) || []) : [];
  const choices = orgs.filter((o) => o.alias).map((o) => ({ alias: String(o.alias).split(',')[0].trim(), username: o.username, kind: lib.classifyByFacts(o), instanceUrl: o.instanceUrl }))
    .filter((o, i, all) => all.findIndex((x) => x.alias === o.alias) === i);
  let projectOrg = null;
  const envVals = envfile.read(root) || {};
  // No org chosen yet, but .env names the user: pick the signed-in org with that user name.
  const byUser = !(flags['--org'] && flags['--org'] !== true) && !cfg.mcp.org && !cfg.orgs.dev && envVals.SF_USERNAME
    ? choices.find((o) => o.username === envVals.SF_USERNAME) : null;
  if ((flags['--org'] && flags['--org'] !== true) || byUser) {
    const alias = byUser ? byUser.alias : String(flags['--org']);
    const c = lib.classifyOrg(alias, cfg, root);
    if (c.kind === 'unknown' && !offline) add('Salesforce', `Project org "${alias}"`, 'claude', `${c.reason}. A browser window opens; you sign in.`, { command: `sf-sdlc org login --alias ${alias}`, then: `sf-sdlc setup --org ${alias}` });
    else {
      saveConfig((j) => {
        j.orgs = j.orgs || {}; j.mcp = j.mcp || {};
        if (c.kind === 'production') { j.orgs.production = [...new Set([...(j.orgs.production || []), alias])]; if (j.orgs.dev === alias) j.orgs.dev = ''; }
        else j.orgs.dev = alias;
        j.mcp.org = alias;
      });
      projectOrg = alias;
    }
  } else {
    const cand = cfg.mcp.org ? lib.resolveOrg(cfg.mcp.org, cfg) : cfg.orgs.dev;
    if (cand) projectOrg = cand;
  }
  if (lib.has('sf') || !wantSf) {
    if (projectOrg) {
      const c = lib.classifyOrg(projectOrg, cfg, root);
      add('Salesforce', 'Project org', 'done', `${projectOrg} (${c.kind}${c.kind === 'production' ? ' — protected: every change asks first' : ''})${byUser && byUser.alias === projectOrg ? ' — matched SF_USERNAME in .env' : ''}`);
    } else if (!wantSf) add('Salesforce', 'Project org', 'skipped', 'not needed for requirements work');
    else if (choices.length) add('Salesforce', 'Project org', 'you', 'Which signed-in org is this project for?', { ask: 'org', choices: choices.map(({ alias, kind }) => ({ alias, kind })), command: 'sf-sdlc setup --org <alias>' });
    else {
      const alias = /^[A-Za-z0-9_.-]+$/.test(envVals.SF_ORG_ALIAS || '') ? envVals.SF_ORG_ALIAS : 'dev';
      add('Salesforce', 'Project org', 'claude', `No org is signed in. A browser window opens at ${envVals.SF_LOGIN_URL ? 'the login address in .env (SF_LOGIN_URL)' : 'login.salesforce.com (for a sandbox, put SF_LOGIN_URL=https://test.salesforce.com or your My Domain in .env first — Claude can write it)'}; you sign in and allow access.`, { command: `sf-sdlc org login --alias ${alias}`, then: `sf-sdlc setup --org ${alias}` });
    }
  }

  // 5. Skills: the core set always, then what the code shows, in priority order, inside the listing budget.
  const BUDGET = 8000;
  let rec = { d: detect(), ordered: [] };
  try { rec = recommendData(profile === 'ba' || (profile && rec.d.total === 0) ? profile : undefined); } catch { /* no catalog */ }
  const cost = (n) => Math.min(skillDescription(path.join(libraryDir(), n)).length, 1536) + n.length;
  // The mandatory core set is installed whatever it costs; the budget applies to on-demand skills.
  let used = skillsState().onDemandChars;
  const take = []; const later = [];
  // Priority: core, then the main skill for each kind of code found, then deploy and analysis, then the rest.
  const rank = (p) => p.core ? 0 : p.kind === 'code' && p.primary ? 1 : p.kind === 'base' ? (p.primary ? 2 : 3) : p.kind === 'code' ? 4 : 5;
  for (const p of rec.ordered.map((p, i) => ({ ...p, i })).sort((a, b) => rank(a) - rank(b) || a.i - b.i)) {
    if (p.installed) continue;
    const c = cost(p.name);
    if (p.core) take.push(p.name);
    else if (used + c <= BUDGET) { take.push(p.name); used += c; } else later.push(p.name);
  }
  const res = take.length ? installSkills(take) : [];
  const now = skillsState();
  const d = rec.d;
  const found = d.total ? Object.entries(d.counts).sort((a, b) => b[1] - a[1]).slice(0, 4).map(([t, n]) => `${n} ${t}`).join(', ') : '';
  add('Project', 'Code explored', 'done', d.isSfdxProject ? (d.total ? `${d.total} components (${found})` : 'new Salesforce project, no metadata yet') : 'no Salesforce source here (documents and requirements still work)');
  add('Skills', 'Skills for this project', 'done', `${now.installed.length} installed${res.filter((r) => r.result === 'installed').length ? ` (${res.filter((r) => r.result === 'installed').length} added now)` : ''}: the mandatory core set (${now.installed.filter((x) => x.core).length} — draw.io, diagrams and every Salesforce platform skill; the sdlc-* skills come with the kit) plus what the code needs`, { installed: now.installed.map((x) => x.name), added: res.filter((r) => r.result === 'installed').map((r) => r.name), availableLater: later });
  if (later.length) add('Skills', `${later.length} more skills match the code`, 'optional', 'left out to keep Claude fast; add any by name when the work needs it', { command: `sf-sdlc skills install ${later.slice(0, 3).join(' ')}${later.length > 3 ? ' …' : ''}`, names: later });

  // 6. Salesforce hosted MCP servers
  const servers = mcp.enabledServers(cfg);
  const others = Object.keys(mcp.HOSTED_SERVERS).filter((n) => !servers.includes(n));
  const mcpOrg = mcp.mcpOrg(root, cfg);
  const orgFacts = choices.find((o) => o.alias === mcpOrg || o.username === mcpOrg);
  const setupUrl = orgFacts && orgFacts.instanceUrl ? orgFacts.instanceUrl.replace(/\/$/, '') + mcp.SETUP_PATH : null;
  if (wantSf && servers.length) {
    let probes = null;
    if (!offline && lib.has('sf') && mcpOrg) { probes = []; for (const n of servers) probes.push(await mcp.probe(n, root, cfg, mcpOrg)); }
    for (const n of servers) {
      const pr = probes && probes.find((x) => x.name === n);
      const label = `Salesforce MCP server: ${n}`;
      if (pr && pr.state === 'ok') add('Connections', label, 'done', `connected to ${mcpOrg} (${pr.tools.length} tools)`);
      else if (pr && pr.state === 'inactive') add('Connections', label, 'you', `switched off in org ${mcpOrg}. Open Setup, type "MCP" in Quick Find, open MCP Servers and turn on "${n}". Takes effect in about two minutes.`, { url: setupUrl, command: `sf org open --target-org ${mcpOrg} --path ${mcp.SETUP_PATH}` });
      else if (pr && pr.state === 'auth') add('Connections', label, 'you', `the sign-in to ${mcpOrg} did not work (expired, or the user has no API access)`, { command: `sf org login web --alias ${mcpOrg}` });
      else if (pr) add('Connections', label, 'you', `could not reach it: ${pr.detail.slice(0, 120)}`);
      else add('Connections', label, 'you', mcpOrg ? `not checked yet. Turn it on in the org: Setup → Quick Find "MCP" → MCP Servers.` : 'waits for the project org above', { url: setupUrl });
    }
    add('Connections', 'Other Salesforce MCP servers', 'optional', `off by default: ${others.map((n) => `${n} (${mcp.HOSTED_SERVERS[n].summary})`).join('; ')}`, { command: 'sf-sdlc mcp enable <name>', names: others });
  }

  // 6b. Browser for UI tests (Playwright MCP). Setup prepares the profile so the Salesforce sign-in
  // survives restarts; nobody has to change a browser setting by hand.
  let bs = browserLib.status(root, cfg);
  if (bs.enabled && bs.ready && !bs.inUse) { try { lib.stateDir(root); browserLib.prepareProfile(root, bs.browser); bs = browserLib.status(root, cfg); } catch { /* reported below */ } }
  if (!bs.enabled) add('Connections', 'Browser for UI tests', 'skipped', 'turned off (browser.enabled is false)');
  else if (bs.ready) add('Connections', 'Browser for UI tests (Playwright)', 'done', `ready (${bs.browser}${bs.headless ? ', headless' : ''}). The first time Claude tests in the browser, a window opens at your org and you sign in once; the sign-in is kept in ${bs.profile}/ for later sessions${bs.keepsSignIn ? ', also after a restart, until Salesforce\'s session timeout' : ''}`);
  else add('Connections', 'Browser for UI tests (Playwright)', 'you', bs.reason, { url: LINKS.node });

  // 7. Jira / Confluence and GitHub
  const est = envfile.status(root);
  if (flags['--jira'] === 'no' || flags['--no-jira']) { saveConfig((j) => { j.jira = { ...(j.jira || {}), enabled: false }; }); add('Connections', 'Jira / Confluence', 'skipped', 'not used (stories are written to a CSV file instead)'); }
  else if (est.groups.jira.state === 'configured') add('Connections', 'Jira (API token in .env)', lib.has('uvx') || lib.has('docker') ? 'done' : 'you', lib.has('uvx') || lib.has('docker') ? 'token is filled in; restart Claude Code to connect' : 'token is filled in, but the helper program "uv" is missing', lib.has('uvx') || lib.has('docker') ? {} : { url: LINKS.uv, command: os === 'win' ? 'powershell -c "irm https://astral.sh/uv/install.ps1 | iex"' : 'curl -LsSf https://astral.sh/uv/install.sh | sh' });
  else {
    const missing = Object.entries(est.groups.jira.keys).filter(([, v]) => !v).map(([k]) => k);
    add('Connections', 'Jira / Confluence', 'you', `Easiest: type /mcp in Claude Code, choose "atlassian" (shown as plugin:sf-sdlc:atlassian), choose Authenticate and sign in in the browser. Or use an API token: create one at the link, then type it into .env as JIRA_API_TOKEN${missing.filter((k) => k !== 'JIRA_API_TOKEN').length ? ` (also still empty: ${missing.filter((k) => k !== 'JIRA_API_TOKEN').join(', ')} — tell Claude the address and e-mail and it fills those)` : ''}. Not using Jira? Say so.`, { url: LINKS.atlassianToken, ask: 'jira' });
  }
  const gh = rows.find((r) => r.id === 'gh');
  const ghAuth = rows.find((r) => r.id === 'gh-auth');
  if (gh && gh.ok) add('Connections', 'GitHub sign-in', ghAuth && ghAuth.ok ? 'done' : 'claude', ghAuth && ghAuth.ok ? 'gh is signed in' : 'A browser window opens; you sign in to GitHub.', ghAuth && ghAuth.ok ? {} : { command: 'gh auth login --web --git-protocol https' });

  // 8. Configuration
  const v = lib.validateConfig(cfg);
  add('Project', 'Configuration (.claude/sf-sdlc.json)', v.ok ? 'done' : 'you', v.ok ? 'valid' : v.errors.join('; '));
  if (!cfg.project.code) add('Project', 'Project code (short prefix for documents, e.g. ACME)', 'optional', 'not set; tell Claude and it fills it in', { ask: 'projectCode' });

  const count = (st) => steps.filter((x) => x.state === st);
  const icon = { done: '✅', claude: '🔧', you: '👉', optional: '➖', skipped: '➖' };
  const word = { done: 'Done', claude: 'Claude can do this — say yes', you: 'Needs you', optional: 'Optional', skipped: 'Skipped' };
  const act = (x) => `**${x.item}** — ${x.detail}${x.url ? `\n   Link: ${x.url}` : ''}${x.command ? `\n   Command: \`${x.command}\`` : ''}${x.then ? `\n   Then: \`${x.then}\`` : ''}`;
  const result = {
    ok: count('you').length === 0 && count('claude').length === 0,
    project: cfg.project.name || path.basename(root), profile, projectOrg,
    summary: { done: count('done').length, claudeCanDo: count('claude').length, needsYou: count('you').length, optional: count('optional').length + count('skipped').length },
    steps, orgChoices: choices.map(({ alias, kind }) => ({ alias, kind })),
    restartNeeded: files.created.length > 0 || res.some((r) => r.result === 'installed'),
  };
  out(result, () => [
    `## Setup checklist — ${result.project}`,
    `${result.summary.done} done · ${result.summary.needsYou} need you · ${result.summary.claudeCanDo} Claude can do on a yes · ${result.summary.optional} optional`,
    '',
    '| | Area | Step | Status |', '|---|---|---|---|',
    ...steps.map((x) => `| ${icon[x.state]} | ${x.area} | ${x.item} | ${x.state === 'done' ? x.detail.replace(/\|/g, '/') : word[x.state]} |`),
    ...(count('you').length ? ['', '### 👉 Your turn', ...count('you').map((x, i) => `${i + 1}. ${act(x)}`)] : []),
    ...(count('claude').length ? ['', '### 🔧 Claude can do these — just say yes', ...count('claude').map((x, i) => `${i + 1}. ${act(x)}`)] : []),
    ...(count('optional').length ? ['', '### ➖ Optional, any time', ...count('optional').map((x) => `- ${act(x)}`)] : []),
    '', result.restartNeeded ? 'Last step: restart Claude Code (or run /reload-plugins) so the new skills, rules and connections load.' : 'Nothing new to load.',
    'Run `sf-sdlc setup` again at any time to refresh this list.',
  ].join('\n'));
}

// ------------------------------------------------------------------ templates

// Document and Jira templates a team may replace with its own. The project copy lives in
// <paths.templates>/<area>/<file> and wins over the kit's copy in the skill's references/.
const TEMPLATE_AREAS = {
  brd: 'sdlc-brd-generate',
  jira: 'sdlc-jira-story-generate',
  architecture: 'sdlc-architecture-diagram',
  discovery: 'sdlc-discovery-fit-gap',
  spec: 'sdlc-spec-driven-development',
  qa: 'sdlc-qa-test-case-generate',
  testing: 'sdlc-test-execution',
  review: 'sdlc-code-review',
  release: 'sdlc-deploy-release',
  workflow: 'sdlc-workflow',
};
const TEMPLATE_EXTRAS = { jira: ['jira-csv-import.md'], review: ['review-checklist.md'] };

function templateList() {
  const base = cfg.paths.templates || 'docs/sdlc/templates';
  const rows = [];
  for (const [area, skill] of Object.entries(TEMPLATE_AREAS)) {
    const refs = path.join(lib.KIT_ROOT, 'skills', skill, 'references');
    if (!fs.existsSync(refs)) continue;
    const found = [];
    lib.walk(refs, (full, e, isDir) => { if (!isDir) found.push(path.relative(refs, full)); });
    const files = found.filter((f) => /\.(md|ya?ml|csv)$/.test(f) && (/-template\.[a-z]+$/.test(path.basename(f)) || (TEMPLATE_EXTRAS[area] || []).includes(path.basename(f))));
    for (const rel of files.sort()) {
      const name = path.basename(rel);
      const project = path.join(base, area, name);
      rows.push({ id: `${area}/${name}`, area, skill, kit: path.relative(lib.KIT_ROOT, path.join(refs, rel)), project, overridden: fs.existsSync(path.join(root, project)) });
    }
  }
  return { folder: base, templates: rows };
}

function templatesCmd() {
  const sub = pos[1] || 'list';
  const all = templateList();
  if (sub === 'list') {
    return out(all, () => `Project templates folder: ${all.folder}/ (a file there replaces the kit's copy)\n` +
      all.templates.map((t) => `${t.overridden ? '✔ project' : '• kit    '}  ${t.id}`).join('\n') +
      '\n\nCopy one to edit it: sf-sdlc templates copy <id | area | all>');
  }
  if (sub === 'copy') {
    const want = pos.slice(2);
    if (!want.length) fail('usage: sf-sdlc templates copy <id | area | all>  (ids from `sf-sdlc templates list`)');
    const picked = all.templates.filter((t) => want.includes('all') || want.includes(t.id) || want.includes(t.area));
    const unknown = want.filter((w) => w !== 'all' && !all.templates.some((t) => t.id === w || t.area === w));
    if (unknown.length) fail(`unknown template or area: ${unknown.join(', ')}. Run \`sf-sdlc templates list\`.`);
    const copied = [];
    const skipped = [];
    for (const t of picked) {
      const dest = path.join(root, t.project);
      if (fs.existsSync(dest)) { skipped.push(`${t.project} (exists; not overwritten)`); continue; }
      fs.mkdirSync(path.dirname(dest), { recursive: true });
      fs.copyFileSync(path.join(lib.KIT_ROOT, t.kit), dest);
      copied.push(t.project);
    }
    return out({ ok: true, copied, skipped }, () => [...copied.map((c) => `copied  ${c}`), ...skipped.map((s) => `skipped ${s}`)].join('\n') +
      `\n\nEdit the copies to match your team's format; the skills now use them. Commit ${all.folder}/.`);
  }
  fail('usage: sf-sdlc templates list | templates copy <id | area | all>');
}

function discoverCmd() {
  const sub = pos[1];
  const at = (p) => path.resolve(root, p);
  try {
    if (sub === 'snapshot') {
      const wanted = flags['--org'] ? [flags['--org']] : (cfg.discovery.orgs.length ? cfg.discovery.orgs : [lib.defaultOrg(root)].filter(Boolean));
      if (!wanted.length) fail('no org: pass --org <role|alias>, list orgs in discovery.orgs, or set a default org');
      if (flags['--output'] && wanted.length > 1) fail('--output works with one org; pass --org as well');
      const taken = wanted.map((w) => discoverLib.snapshot(root, cfg, lib.resolveOrg(w, cfg), { output: flags['--output'] }));
      return out({ ok: true, snapshots: taken }, () => taken.map(({ dir, manifest: m }) => {
        const bad = m.queries.filter((q) => !q.ok);
        return `${m.alias} (${m.orgKind}${m.orgName ? `, ${m.orgName}` : ''}, org ${m.orgId || 'unknown'}) -> ${dir}\n` +
          `  ${m.queries.length - bad.length}/${m.queries.length} queries ok (read-only)` +
          (bad.length ? `\n  not available: ${bad.map((q) => `${q.name} (${q.error.slice(0, 90)})`).join('\n                 ')}` : '');
      }).join('\n\n') + '\n\nNext: sf-sdlc discover summary <snapshot>, or compare two snapshots.');
    }
    if (sub === 'summary') {
      if (!pos[2]) fail('usage: sf-sdlc discover summary <snapshot folder>');
      const s = discoverLib.summarize(at(pos[2]));
      return out(s, () => [
        `${s.alias} (${s.orgKind}, org ${s.orgId || 'unknown'}) taken ${s.takenAt}; ${s.queries.ok} queries ok, ${s.queries.failed} not available`,
        `data model   ${JSON.stringify(s.dataModel)}`, `automation   ${JSON.stringify(s.automation)}`, `code         ${JSON.stringify(s.code)}`,
        `security     ${JSON.stringify(s.security)}`, `integration  ${JSON.stringify(s.integration)}`,
        `packages     ${s.packages.join(', ') || 'none'}`, `adoption     ${JSON.stringify(s.adoption)}`,
        '', `findings (${s.findings.length}):`, ...s.findings.map((f) => `  [${f.severity}] ${f.domain}: ${f.text}  <- ${f.evidence}`),
      ].join('\n'));
    }
    if (sub === 'compare') {
      if (!pos[2] || !pos[3]) fail('usage: sf-sdlc discover compare <snapshotA> <snapshotB>');
      const c = discoverLib.compare(at(pos[2]), at(pos[3]));
      return out(c, () => [
        `A = ${c.a.alias} (${c.a.orgKind}, ${c.a.takenAt})   B = ${c.b.alias} (${c.b.orgKind}, ${c.b.takenAt})`,
        `type                  only A  only B    same  differ`,
        ...Object.entries(c.types).map(([t, v]) => `${t.padEnd(20)} ${String(v.onlyA.length).padStart(7)} ${String(v.onlyB.length).padStart(7)} ${String(v.same).padStart(7)} ${String(v.differs.length).padStart(7)}`),
        Object.keys(c.orgWideDefaults).length ? `\norg-wide defaults that differ: ${Object.entries(c.orgWideDefaults).map(([k, [a, b]]) => `${k} ${a} vs ${b}`).join('; ')}` : '\norg-wide defaults: same',
        '\nFull lists: add --json.',
      ].join('\n'));
    }
  } catch (e) { return fail(String(e && e.message || e)); }
  fail('usage: sf-sdlc discover snapshot [--org <role|alias>] | discover summary <snapshot> | discover compare <snapshotA> <snapshotB>');
}

const HELP = `sf-sdlc — Salesforce SDLC toolkit (add --json to any command)

  setup [--org <alias>] [--profile developer|admin|ba] [--install-tools] [--no-jira] [--no-git] [--offline]
                               do everything that needs no decision (files, git, skills, checks) and print a
                               checklist: done, what Claude can do on a yes, what needs you (with links)
  doctor                       check tools, plugins, config and org setup
  init                         create .claude/sf-sdlc.json, .gitignore entries, code-analyzer.yml, .env and .env.sample;
                               plugin users also get project settings (plugin on at project scope) and .claude/rules/
  env status|init|gh-login     .env settings: which are set (never values), create the template, sign gh in
  env set KEY=VALUE            write an address or user name into .env (never a token): SF_LOGIN_URL, SF_USERNAME, …
  config show|validate         show the merged configuration, or validate it
  detect                       what this project contains (metadata folders, counts, tooling)
  inventory                    existing-state inventory of the source tree, by metadata type
  delta [--from <git-ref>]     components new / changed / removed against a git ref (--manifest writes package.xml)
  skills recommend [--profile developer|admin|ba]
  skills install|remove <name...>, skills list [--all], skills sync [--dry-run]
  templates list               document and Jira templates, and which ones the project overrides
  templates copy <id|area|all> copy the kit's template into paths.templates for the team to edit
  org classify [alias]         production | sandbox | scratch | developer | unknown
  org login [--alias a] [--instance-url u]
                               browser sign-in (sf org login web) using SF_ORG_ALIAS and SF_LOGIN_URL from .env
  browser status|reset         browser for UI tests (Playwright MCP): ready?, where the sign-in is kept; reset signs out
  browser url [--org role]     the org's Lightning address for the browser (sandbox/scratch/developer only, no token)
  analyze [--staged | --changed [ref] | <paths>] [--severity 1-5] [--report out.html,out.sarif]
                               official Salesforce Code Analyzer (sf code-analyzer run)
  check [files...]             fast offline source checks (default: files changed on this branch)
  deploy validate|quick|report|preview --org <role|alias> [--delta --from <ref>] [--manifest f] [--print]
  test run|report --org <role|alias> [--tests A,B.method] [--level RunLocalTests]
  diagram render <file>        Mermaid to SVG (needs mermaid-cli)
  diagram drawio <spec.json | components.json> [--type solution|data-model] [--story US-nn-mm] [--output f.drawio]
                               Salesforce-style draw.io diagram from a diagram spec or the component model
  diagram export <file.drawio> [--format png|svg|pdf] [--output f]   image through draw.io desktop
  diagram check <file.drawio>  structure, Salesforce icon names, header and key
  discover snapshot [--org <role|alias>] [--output dir]
                               read-only snapshot of an existing org's metadata (objects, automation, code,
                               access, integrations, packages, licences, limits) into 00-discovery/snapshots/;
                               without --org, every org in discovery.orgs (else the default org)
  discover summary <snapshot>  counts per domain and findings to look at, from a snapshot
  discover compare <snapshotA> <snapshotB>
                               org-to-org comparison for a merge: only in A, only in B, same, different
  audit [--tail N]             local log of org-affecting commands
  mcp status|list [server...]  Salesforce hosted MCP servers: probe through the sf CLI login, or list
  mcp enable|disable <server>  add or remove a hosted server in mcp.servers
`;

function main() {
  switch (pos[0]) {
    case 'doctor': return doctor();
    case 'init': return init();
    case 'setup': return setupCmd().catch((e) => fail(String(e && e.message || e)));
    case 'config': {
      const v = lib.validateConfig(cfg);
      if (pos[1] === 'validate') { out(v, () => [...v.errors.map((e) => '✘ ' + e), ...v.warnings.map((w) => '• ' + w), v.ok ? 'Configuration is valid.' : 'Configuration has errors.'].join('\n')); process.exit(v.ok ? 0 : 1); }
      const { _exists, _invalid, ...shown } = cfg;
      return out({ ...shown, _source: _exists ? '.claude/sf-sdlc.json' : 'defaults' });
    }
    case 'detect': return out(detect());
    case 'inventory': {
      const inv = ops.inventory(root, cfg);
      return out(inv, () => `Package directories: ${inv.packageDirectories.join(', ') || '(none)'}   API ${inv.apiVersion || '?'}\n${inv.total} components\n` + Object.entries(inv.counts).map(([t, n]) => `  ${String(n).padStart(5)}  ${t}`).join('\n'));
    }
    case 'delta': {
      const d = ops.delta(root, cfg, flags['--from']);
      if (d.error) fail(d.error);
      if (flags['--manifest']) {
        const dir = typeof flags['--manifest'] === 'string' ? flags['--manifest'] : path.join('.sf-sdlc', 'delta');
        fs.mkdirSync(path.join(root, dir), { recursive: true });
        fs.writeFileSync(path.join(root, dir, 'package.xml'), ops.packageXml([...d.new, ...d.changed], lib.apiVersion(root, cfg)));
        if (d.removed.length) fs.writeFileSync(path.join(root, dir, 'destructiveChanges.xml'), ops.packageXml(d.removed, lib.apiVersion(root, cfg)));
        d.manifestDir = dir;
      }
      return out(d, () => `Against ${d.base}:\n` + ['new', 'changed', 'removed'].map((k) => `${k.toUpperCase()} (${d[k].length})\n` + d[k].map((c) => `  ${c.type}: ${c.apiName}`).join('\n')).join('\n') + (d.manifestDir ? `\nmanifests written to ${d.manifestDir}/` : ''));
    }
    case 'skills': return skillsCmd();
    case 'templates': return templatesCmd();
    case 'browser': return browserCmd();
    case 'org': {
      if (pos[1] === 'login') return orgLogin();
      if (pos[1] !== 'classify') fail('usage: sf-sdlc org classify [alias] | org login [--alias a] [--instance-url u]');
      const target = lib.resolveOrg(pos[2], cfg) || lib.defaultOrg(root);
      const c = lib.classifyOrg(target, cfg, root);
      return out(c, `${c.target || '(none)'}: ${c.kind} — ${c.reason}`);
    }
    case 'analyze': return analyzeCmd();
    case 'check': return checkCmd();
    case 'deploy': return deployCmd();
    case 'test': return testCmd();
    case 'jobs': return pos[1] === 'watch' ? watchJobs() : out(readJobs());
    case 'diagram': return diagram();
    case 'discover': return discoverCmd();
    case 'audit': return audit();
    case 'mcp': return mcpCmd().catch((e) => fail(String(e && e.message || e)));
    case 'env': return envCmd();
    default: process.stdout.write(HELP); process.exit(pos[0] && pos[0] !== 'help' ? 1 : 0);
  }
}

main();
