{
  "$comment": "Project signal -> skills to recommend. `folders` are metadata folder names found under the package directories; a rule fires when any listed folder exists. `mcpServers` fires when any listed hosted MCP server is in mcp.servers of .claude/sf-sdlc.json. `core` rules fire for every project and profile. `profiles` are starter sets chosen with `sf-sdlc skills recommend --profile <name>`. Skills not present in the catalog are ignored, so a rule can name a skill that only newer upstream versions ship.",
  "rules": [
    { "id": "core", "reason": "Core set for every project and every profile: diagrams, Salesforce documentation, SOQL, API context, environment check and org management",
      "when": { "core": true },
      "skills": ["sf-diagram", "external-diagram-mermaid-generate", "platform-docs-get", "platform-soql-query", "platform-metadata-api-context-get", "platform-environment-validate", "dx-org-manage"] },
    { "id": "base", "reason": "Deploy, retrieve and the official Code Analyzer are needed by every Salesforce DX project",
      "when": { "always": true, "profiles": ["developer", "admin"] },
      "skills": ["platform-metadata-deploy", "platform-metadata-retrieve", "dx-code-analyzer-run", "dx-code-analyzer-custom-rule-create"] },
    { "id": "grounding", "reason": "Find metadata that already exists in the org by meaning before creating new metadata (Metadata Grounding MCP)",
      "when": { "mcpServers": ["metadata-grounding"] },
      "skills": ["platform-metadata-grounding-get", "platform-metadata-discovery-get"] },
    { "id": "headless-360", "reason": "Read live Setup state and run org operations through the Headless 360 MCP server",
      "when": { "mcpServers": ["headless-360"] },
      "skills": ["platform-headless-360-integrate"] },
    { "id": "greenfield", "reason": "Starter set for a new project until real metadata shows what is needed",
      "when": { "greenfield": true, "profiles": ["developer"] },
      "skills": ["platform-apex-generate", "platform-apex-test-generate", "platform-apex-test-run", "experience-lwc-generate", "platform-custom-object-generate", "platform-custom-field-generate", "platform-permission-set-generate", "sf-flow"] },
    { "id": "apex", "reason": "The project contains Apex",
      "when": { "folders": ["classes", "triggers"] },
      "skills": ["platform-apex-generate", "platform-apex-test-generate", "platform-apex-test-run", "platform-apex-logs-debug"] },
    { "id": "lwc", "reason": "The project contains Lightning Web Components",
      "when": { "folders": ["lwc"] },
      "skills": ["experience-lwc-generate", "design-systems-slds-apply"] },
    { "id": "aura", "reason": "The project contains Aura components that are candidates for migration",
      "when": { "folders": ["aura"] },
      "skills": ["experience-aura-lwc-migrate"] },
    { "id": "flow", "reason": "The project contains Flows (sf-flow writes Flow metadata without needing a Salesforce MCP server)",
      "when": { "folders": ["flows"], "profiles": ["admin"] },
      "skills": ["sf-flow"] },
    { "id": "data-model", "reason": "The project contains custom objects and fields",
      "when": { "folders": ["objects"], "profiles": ["admin"] },
      "skills": ["platform-custom-object-generate", "platform-custom-field-generate", "platform-validation-rule-generate"] },
    { "id": "permissions", "reason": "The project contains permission sets",
      "when": { "folders": ["permissionsets", "permissionsetgroups", "customPermissions"], "profiles": ["admin"] },
      "skills": ["platform-permission-set-generate"] },
    { "id": "sharing", "reason": "The project contains sharing rules or roles",
      "when": { "folders": ["sharingRules", "roles"] },
      "skills": ["platform-sharing-rules-generate", "platform-sharing-owd-configure", "platform-role-hierarchy-apply"] },
    { "id": "custom-metadata", "reason": "The project contains Custom Metadata records",
      "when": { "folders": ["customMetadata"] },
      "skills": ["platform-custom-metadata-type-generate"] },
    { "id": "pages", "reason": "The project contains Lightning pages, apps or tabs",
      "when": { "folders": ["flexipages", "applications", "tabs"] },
      "skills": ["platform-flexipage-generate", "platform-custom-application-generate", "platform-custom-tab-generate"] },
    { "id": "reports", "reason": "The project contains reports, dashboards or report types",
      "when": { "folders": ["reports", "dashboards", "reportTypes"], "profiles": ["admin"] },
      "skills": ["platform-report-generate", "platform-custom-report-type-generate"] },
    { "id": "integration", "reason": "The project contains integration metadata (credentials, connected apps, external services)",
      "when": { "folders": ["namedCredentials", "externalCredentials", "connectedApps", "externalClientApps", "externalServiceRegistrations", "remoteSiteSettings"] },
      "skills": ["integration-connectivity-generate", "integration-connectivity-connected-app-configure", "sf-integration"] },
    { "id": "eventing", "reason": "The project contains platform event or Change Data Capture channels",
      "when": { "folders": ["platformEventChannels", "platformEventChannelMembers"] },
      "skills": ["integration-eventing-cdc-configure", "integration-eventing-subscription-configure"] },
    { "id": "omnistudio", "reason": "The project contains OmniStudio components",
      "when": { "folders": ["omniScripts", "omniIntegrationProcedures", "omniDataTransforms", "omniUiCard"] },
      "skills": ["omnistudio-omniscript-generate", "omnistudio-integration-procedure-generate", "omnistudio-datamapper-generate", "omnistudio-flexcard-generate", "omnistudio-dependencies-analyze"] },
    { "id": "agentforce", "reason": "The project contains Agentforce or bot metadata",
      "when": { "folders": ["bots", "genAiPlannerBundles", "genAiPlugins", "genAiFunctions", "genAiPromptTemplates", "aiAuthoringBundles"] },
      "skills": ["agentforce-generate", "agentforce-test", "agentforce-observe"] },
    { "id": "experience", "reason": "The project contains Experience Cloud sites",
      "when": { "folders": ["digitalExperiences", "experiences", "sites", "networks"] },
      "skills": ["experience-lwr-site-generate", "experience-portal-create", "experience-accessibility-validate"] },
    { "id": "packaging", "reason": "sfdx-project.json defines packages",
      "when": { "packaging": true },
      "skills": ["dx-pkg-post-install-configure", "dx-org-devhub-configure", "dx-scratch-def-configure"] },
    { "id": "scratch", "reason": "The project uses scratch orgs",
      "when": { "rootFiles": ["config/project-scratch-def.json"] },
      "skills": ["dx-org-devhub-configure", "dx-org-shape-manage"] },
    { "id": "data", "reason": "Test data loading and cleanup for developers and admins",
      "when": { "profiles": ["developer", "admin"] },
      "skills": ["platform-data-manage"] }
  ]
}
