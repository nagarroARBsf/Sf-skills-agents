    { "id": "reg", "title": "Deal Registration", "subtitle": "Deal_Registration__c", "entity": "cloud", "status": "new", "story": "US-06-01", "attributes": ["# Name", "• Partner_Account__c", "• Opportunity__c", "• Status__c"] },
    { "id": "opp", "title": "Opportunity", "subtitle": "Opportunity", "entity": "extended", "status": "changed", "story": "US-04-01", "attributes": ["# Name", "• StageName", "+ Deal_Health_Score__c", "+ Deal_Health_Band__c", "+ Discount_Percentage__c"] },
